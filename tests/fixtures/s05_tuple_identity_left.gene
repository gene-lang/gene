(tuple NamedPair left: Int right: Int)
(tuple PosBox String Int)
(tuple UnitTuple)
(tuple Wrapper payload: Any)

(fn make_pair [] -> NamedPair
  (NamedPair 1 2)
)

(fn make_named [] -> NamedPair
  (NamedPair ^right 8 ^left 7)
)

(fn make_named_positional [] -> NamedPair
  (NamedPair 7 8)
)

(fn make_positional [] -> PosBox
  (PosBox "left" 9)
)

(fn make_unit [] -> UnitTuple
  (UnitTuple)
)

(fn wrap_named [] -> Wrapper
  (Wrapper (make_named))
)

(export NamedPair PosBox UnitTuple Wrapper make_pair make_named make_named_positional make_positional make_unit wrap_named)
