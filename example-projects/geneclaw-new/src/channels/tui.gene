# Terminal UI view-model helpers.

(import genex/readline)
(import reset_runs replay_run cancel_run terminal_run_state from "kernel/runs")
(import events_for from "kernel/events")
(import stored_run_ids store_root from "kernel/storage")
(import scheduler_jobs from "scheduler/jobs")
(import memory_search from "memory/store")
(import code_input from "code_eval")
(import shell_input from "shell_eval")
(import tool_defs from "tools/registry")
(import load_skill filter_tool_defs_for_skill infer_skill_name from "skills/loader")
(import build_model_request build_provider_payload from "models/gateway")

(fn ensure_array [value]
  (if (value is Array) value else [])
)

(fn ensure_map [value]
  (if (value is Map) value else {})
)

(fn recent_events [run_id limit]
  (var events (events_for run_id))
  (var max_count (try limit/.to_i catch * 20))
  (if (max_count < 1)
    (max_count = 1)
  )
  (var start_index (events/.size - max_count))
  (if (start_index < 0)
    (start_index = 0)
  )
  (var result [])
  (var index start_index)
  (while (index < events/.size)
    (var event (events .get index))
    (result .append {
      ^id event/id
      ^type event/type
      ^run_id event/run_id
      ^at_ms event/at_ms
      ^data event/data
    })
    (index += 1)
  )
  result
)

(fn run_card [run_id]
  (var summary (replay_run run_id))
  (if (summary == nil)
    (return {^id run_id ^state "missing" ^goal "" ^final ""})
  )
  (var run_events (events_for run_id))
  {
    ^id summary/id
    ^state summary/state
    ^goal summary/goal
    ^session summary/session
    ^final summary/final
    ^event_count run_events/.size
  }
)

(fn render_run_line [card]
  #"#{card/id} #{card/state} #{card/goal}"
)

(fn render_event_line [event]
  #"#{event/id} #{event/type}"
)

(fn render_lines [lines]
  (lines .join "\n")
)

(fn env_text [name fallback = ""]
  ((($env .get name fallback) || "") .to_s)
)

(fn env_mode [name fallback = ""]
  (var value ((env_text name fallback) .trim))
  value/.to_lower
)

(fn $ns/tui_color_enabled []
  (var mode (env_mode "GENECLAW_TUI_COLOR" "auto"))
  (if (["1" "true" "always" "on"] .contains mode)
    (return true)
  )
  (if ((["0" "false" "never" "off"] .contains mode) || ((env_text "NO_COLOR") .not_empty))
    (return false)
  )
  (stdout .isatty)
)

(fn $ns/tui_colorize [code text]
  (var value ((text || "") .to_s))
  (if_not (tui_color_enabled)
    (return value)
  )
  #"\u001b[#{code}m#{value}\u001b[0m"
)

(fn $ns/tui_prompt_text [text]
  (tui_colorize "36" text)
)

(fn $ns/tui_response_text [text]
  (tui_colorize "32" text)
)

(fn tui_warning_text [text]
  (tui_colorize "33" text)
)

(fn $ns/tui_program_text [text]
  (tui_colorize "90" text)
)

(fn tui_prefix_lines [first_prefix rest_prefix text]
  (var value ((text || "") .to_s))
  (var lines (value .split "\n"))
  (var result [])
  (var index 0)
  (while (index < lines/.size)
    (var line (lines .get index))
    (if (index == 0)
      (result .append #"#{first_prefix}#{line}")
     else
      (result .append #"#{rest_prefix}#{line}")
    )
    (index += 1)
  )
  (result .join "\n")
)

(fn tui_status_text [text]
  (tui_program_text #"\u2022 #{text}")
)

(fn tui_output_text [text]
  (tui_program_text text)
)

(fn tui_error_text [text]
  (tui_colorize "31" (tui_prefix_lines "\u2022 " "  " text))
)

(fn tui_assistant_text [text]
  (tui_response_text (tui_prefix_lines "\u2022 " "  " text))
)

(fn tui_section_text [title text]
  #"#{title}:\n#{((text || "") .to_s)}"
)

(fn $ns/tui_child_output_text [text]
  (var value ((text || "") .to_s))
  (if ((value .contains " completed:") || (value .contains " completed"))
    (return (tui_response_text value))
  )
  (if ((value .contains " failed:") || (value .contains " failed"))
    (return (tui_colorize "31" value))
  )
  (if ((value .contains " cancelled") || (value .contains " interrupted") || (value .contains " timed_out"))
    (return (tui_warning_text value))
  )
  (tui_program_text value)
)

(fn run_summary_tail [line marker]
  (var parts (((line || "") .to_s) .split marker))
  (if (parts/.size < 2)
    (return nil)
  )
  (var prefix ((parts .get 0) .trim))
  (if ((prefix .starts_with "run-") == false)
    (return nil)
  )
  ((parts .slice 1) .join marker)
)

(fn $ns/tui_child_display_text [goal line]
  (var value ((line || "") .to_s))
  (var completed (run_summary_tail value " completed: "))
  (if (completed != nil)
    (if ((shell_input goal) || (code_input goal))
      (return (tui_output_text completed))
     else
      (return (tui_assistant_text completed))
    )
  )
  (var failed (run_summary_tail value " failed: "))
  (if (failed != nil)
    (if ((shell_input goal) || (code_input goal))
      (return (tui_output_text failed))
     else
      (return (tui_error_text failed))
    )
  )
  (if ((shell_input goal) || (code_input goal))
    (return (tui_output_text value))
  )
  (tui_child_output_text value)
)

(fn tui_run_header_text [goal]
  (var text (((goal || "") .to_s) .trim))
  (if (shell_input text)
    (return (tui_status_text #"Ran #{text}"))
  )
  (if (code_input text)
    (return (tui_status_text "Evaluating Gene code"))
  )
  (tui_status_text "Working")
)

(fn $ns/tui_exit_command [input]
  (var text (((input || "") .to_s) .trim))
  ((text == "/quit") || (text == "/exit"))
)

(fn $ns/tui_slash_command [input]
  (var text (((input || "") .to_s) .trim))
  (text .starts_with "/")
)

(fn $ns/tui_help_text []
  ([
    "Commands:"
    "/help   show commands"
    "/show-prompt <text>  show the model prompt without creating a run"
    "/reset  reset runtime session data"
    "/clear  clear the screen"
    "/exit   exit GeneClaw"
  ] .join "\n")
)

(fn clear_terminal []
  (stdout .write "\u001b[2J\u001b[H")
  (flush stdout)
)

(fn preview_run_for [text]
  {^id "preview" ^state "queued" ^session "tui" ^goal text ^budgets {} ^deadline_ms 0 ^deadline_at_ms 0 ^final ""}
)

(fn preview_skill_for [text options]
  (var requested ((((options/skill || "") || "") .to_s) .trim))
  (var name (if requested/.not_empty requested else (infer_skill_name text)))
  (var skill (if name/.not_empty (load_skill name) else nil))
  {^name (if (skill == nil) "" else skill/name) ^skill skill ^inferred (requested/.empty && (skill != nil))}
)

(fn payload_system_text [request payload]
  (var text (((payload/instructions || payload/system || request/system || "") .to_s) .trim))
  text
)

(fn payload_user_text [request payload]
  (var messages (ensure_array (payload/messages || [])))
  (if (messages/.size > 1)
    (return (((messages/1/content || "") || "") .to_s))
  )
  (var input (ensure_array (payload/input || [])))
  (if (input/.size > 0)
    (return (((input/0/content || "") || "") .to_s))
  )
  ((request/goal || "") .to_s)
)

(fn preview_tool_lines [request]
  (var names (ensure_array (request/tool_names || [])))
  (if names/.empty
    (return "(none)")
  )
  (var lines [])
  (var index 0)
  (while (index < names/.size)
    (lines .append #"- #{(names .get index)}")
    (index += 1)
  )
  (lines .join "\n")
)

(fn $ns/tui_prompt_preview [input options = {}]
  (var text (((input || "") .to_s) .trim))
  (if text/.empty
    (return "usage: /show-prompt <text>")
  )
  (var opts (ensure_map options))
  (var skill_info (preview_skill_for text opts))
  (var skill (skill_info/skill || nil))
  (var request (build_model_request (opts/provider || "") (preview_run_for text) [] (filter_tool_defs_for_skill (tool_defs) skill) {
    ^profile (opts/profile || "")
    ^model (opts/model || "")
    ^skill (if (skill == nil) "" else skill/name)
    ^system (if (skill == nil) "" else skill/system)
  }))
  (var payload (build_provider_payload request/provider request))
  (if_not (payload/messages is Array)
    (payload = (build_provider_payload "openai" request))
  )
  (var skill_line (if (skill == nil)
    "Skill: (none)"
   else
    #"Skill: #{skill/name}#{(if skill_info/inferred " (inferred)" else "")}"
  ))
  ([
    "Prompt preview"
    #"Text: #{text}"
    skill_line
    #"Provider: #{request/provider}"
    #"Profile: #{request/profile}"
    #"Model: #{request/model}"
    (tui_section_text "System" (payload_system_text request payload))
    (tui_section_text "User" (payload_user_text request payload))
    (tui_section_text "Tools" (preview_tool_lines request))
  ] .join "\n")
)

(fn show_prompt_command_text [text]
  (if (text .starts_with "/show-prompt")
    (return ((text .substr 12) .trim))
  )
  ""
)

(fn $ns/tui_handle_slash_command [input options = {}]
  (var text (((input || "") .to_s) .trim))
  (if (tui_exit_command text)
    (return {^handled true ^exit true ^message ""})
  )
  (if (text == "/help")
    (var message (tui_help_text))
    (println (tui_program_text message))
    (return {^handled true ^exit false ^message message})
  )
  (if (text .starts_with "/show-prompt")
    (var message (tui_prompt_preview (show_prompt_command_text text) options))
    (println (tui_program_text message))
    (return {^handled true ^exit false ^message message})
  )
  (if (text == "/reset")
    (reset_runs)
    (var message "session reset")
    (println (tui_assistant_text message))
    (return {^handled true ^exit false ^message message})
  )
  (if (text == "/clear")
    (clear_terminal)
    (return {^handled true ^exit false ^message ""})
  )
  (if (tui_slash_command text)
    (var message #"unknown command: #{text}")
    (println (tui_warning_text #"\u2022 #{message}"))
    (return {^handled true ^exit false ^message message})
  )
  {^handled false ^exit false ^message ""}
)

(fn $ns/tui_shell_quote [value]
  (var text ((value || "") .to_s))
  #"'#{(text .replace_all "'" "'\"'\"'")}'"
)

(fn option_text [options key]
  ((((options .get key "") || "") .to_s) .trim)
)

(fn append_option_arg [parts flag value]
  (var text (((value || "") .to_s) .trim))
  (if text/.not_empty
    (parts .append flag)
    (parts .append (tui_shell_quote text))
  )
  parts
)

(fn append_budget_arg [parts budgets flag key]
  (var value (budgets .get key nil))
  (if (value != nil)
    (parts .append flag)
    (parts .append (tui_shell_quote value))
  )
  parts
)

(fn $ns/tui_gene_bin []
  (var configured (($env .get "GENECLAW_GENE_BIN" "") .trim))
  (if configured/.not_empty configured else "gene")
)

(fn $ns/tui_run_shell_command [goal budgets = {} options = {}]
  (var parts [(tui_shell_quote (tui_gene_bin)) "run" "src/main.gene" "run"])
  (append_option_arg parts "--skill" (option_text options "skill"))
  (append_option_arg parts "--workflow" (option_text options "workflow"))
  (append_option_arg parts "--provider" (option_text options "provider"))
  (append_option_arg parts "--profile" (option_text options "profile"))
  (append_option_arg parts "--model" (option_text options "model"))
  (append_budget_arg parts budgets "--steps" "steps")
  (append_budget_arg parts budgets "--tool-calls" "tool_calls")
  (parts .append (tui_shell_quote goal))
  (parts .join " ")
)

(fn run_number [run_id]
  (try
    (((run_id .replace_all "run-" "") .trim) .to_i)
   catch *
    0
  )
)

(fn newest_run_id [run_ids]
  (var best "")
  (var best_number 0)
  (var index 0)
  (while (index < run_ids/.size)
    (var id ((run_ids .get index) .to_s))
    (var number (run_number id))
    (if (number > best_number)
      (best = id)
      (best_number = number)
    )
    (index += 1)
  )
  best
)

(fn pad_run_number [number]
  (var text (try number/.to_s catch * "0"))
  (while (text/.size < 4)
    (text = #"0#{text}")
  )
  text
)

(fn $ns/tui_next_run_number []
  ((run_number (newest_run_id (stored_run_ids))) + 1)
)

(fn $ns/tui_prompt []
  #"#{(pad_run_number (tui_next_run_number))}\u203a "
)

(fn $ns/tui_new_run_id [before_ids after_ids]
  (var new_ids [])
  (var index 0)
  (while (index < after_ids/.size)
    (var id (after_ids .get index))
    (if ((before_ids .contains id) == false)
      (new_ids .append id)
    )
    (index += 1)
  )
  (newest_run_id new_ids)
)

(fn cancel_new_run_if_active [before_ids reason]
  (var run_id (tui_new_run_id before_ids (stored_run_ids)))
  (if run_id/.empty
    (return "")
  )
  (var summary (replay_run run_id))
  (if ((summary != nil) && ((terminal_run_state summary/state) == false))
    (try
      (cancel_run run_id reason)
     catch *
      nil
    )
  )
  run_id
)

(fn drain_process_output [goal proc output_lines]
  (var remaining (proc .read_available))
  (if ((remaining || "") .not_empty)
    (stdout .write (tui_child_display_text goal remaining))
    (flush stdout)
    (output_lines .append remaining)
  )
)

(fn $ns/tui_run_goal [goal budgets = {} options = {}]
  (var command (tui_run_shell_command goal budgets options))
  (var before_ids (stored_run_ids))
  (println (tui_run_header_text goal))
  (var proc (system/Process/start "sh" "-lc" #"exec #{command}" ^stderr_to_stdout true ^env {^GENECLAW_NEW_HOME (store_root)}))
  (var output_lines [])
  (var base_sigint (genex/readline/sigint_count))
  (var final_status "")
  (var final_exit_code nil)
  (var final_run_id "")

  (loop
    (var line (proc .read_line ^timeout 0.05))
    (if (line != nil)
      (println (tui_child_display_text goal line))
      (output_lines .append line)
    )

    (if ((genex/readline/sigint_count) > base_sigint)
      (try (proc .signal "INT") catch * nil)
      (var interrupted_code (proc .wait ^timeout 1))
      (if (interrupted_code == nil)
        (try (proc .signal "TERM") catch * nil)
        (interrupted_code = (proc .wait ^timeout 1))
      )
      (if (interrupted_code == nil)
        (try (proc .signal "KILL") catch * nil)
        (interrupted_code = (proc .wait ^timeout 1))
      )
      (var cancelled_run_id ((((cancel_new_run_if_active before_ids "cancelled from tui") || "") .to_s) .trim))
      (if ((run_number cancelled_run_id) <= 0)
        (cancelled_run_id = "")
      )
      (println (tui_warning_text "run interrupted"))
      (final_status = "interrupted")
      (final_exit_code = interrupted_code)
      (final_run_id = cancelled_run_id)
      (break)
    )

    (var proc_alive (proc .alive))
    (if (proc_alive == false)
      (drain_process_output goal proc output_lines)
      (var exit_code (proc .wait ^timeout 0))
      (final_status = (if (exit_code == 0) "completed" else "failed"))
      (final_exit_code = exit_code)
      (final_run_id = (tui_new_run_id before_ids (stored_run_ids)))
      (break)
    )
  )
  {^status final_status ^exit_code final_exit_code ^run_id final_run_id ^output output_lines}
)

(fn $ns/start_tui [budgets = {} options = {}]
  (genex/readline/install_sigint_handler)
  (genex/readline/clear_sigint)
  (var reader (new genex/readline/Reader))
  (var backend (reader .backend))
  (var plain_pipe_input ((backend == "plain") && ((stdin .isatty) == false)))
  (println (tui_program_text #"GeneClaw TUI (#{backend}) \u2022 /help shows commands \u2022 Shift-Enter inserts a newline \u2022 Ctrl-C interrupts \u2022 Ctrl-D exits"))
  (loop
    (var event (reader .read_event (tui_prompt_text (tui_prompt))))
    (if (plain_pipe_input && (event/status != "eof"))
      (println "")
    )
    (if (event/status == "eof")
      (break)
    )
    (if (event/status == "interrupt")
      (println (tui_warning_text "input cleared"))
      (genex/readline/clear_sigint)
      (continue)
    )
    (var input (((event/line || "") .to_s) .trim))
    (if input/.empty
      (continue)
    )
    (var slash_result (tui_handle_slash_command input options))
    (if slash_result/handled
      (if slash_result/exit
        (break)
      )
      (continue)
    )
    (tui_run_goal input budgets options)
  )
  (reader .close)
  (println (tui_response_text "bye"))
  true
)

(fn $ns/tui_run_view [run_id limit = 20]
  (var summary (replay_run run_id))
  (if (summary == nil)
    (return {^ok false ^error #"Run not found: #{run_id}" ^run_id run_id ^summary nil ^events []})
  )
  {^ok true ^run_id run_id ^summary summary ^events (recent_events run_id limit)}
)

(fn $ns/tui_dashboard [run_ids = [] query = ""]
  (var ids (ensure_array run_ids))
  (var query_text (((query || "") .to_s) .trim))
  (var runs [])
  (var index 0)
  (while (index < ids/.size)
    (runs .append (run_card (ids .get index)))
    (index += 1)
  )
  {
    ^runs runs
    ^jobs (scheduler_jobs)
    ^memory (if query_text/.empty [] else (memory_search query_text "" 5))
  }
)

(fn $ns/render_tui_dashboard [view]
  (var source (ensure_map view))
  (var lines ["Runs"])
  (var runs (ensure_array (source .get "runs" [])))
  (var index 0)
  (while (index < runs/.size)
    (lines .append (render_run_line (runs .get index)))
    (index += 1)
  )
  (var jobs (ensure_array (source .get "jobs" [])))
  (var memory (ensure_array (source .get "memory" [])))
  (lines .append #"Jobs: #{jobs/.size}")
  (lines .append #"Memory: #{memory/.size}")
  (render_lines lines)
)

(fn $ns/render_tui_run_view [view]
  (var source (ensure_map view))
  (if ((source .get "ok" false) == false)
    (return ((source .get "error" "Run not found") .to_s))
  )
  (var summary (ensure_map (source .get "summary" {})))
  (var lines [#"Run #{summary/id}" #"State: #{summary/state}" #"Goal: #{summary/goal}" "Events"])
  (var events (ensure_array (source .get "events" [])))
  (var index 0)
  (while (index < events/.size)
    (lines .append (render_event_line (events .get index)))
    (index += 1)
  )
  (render_lines lines)
)
