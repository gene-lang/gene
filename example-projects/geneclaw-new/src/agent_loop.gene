# First vertical agent loop: run kernel + fake model + tool registry.

(import append_event events_for from "kernel/events")
(import create_run transition_run complete_run fail_run run_summary terminal_run_state from "kernel/runs")
(import deadline_exceeded from "kernel/limits")
(import invoke_tool tool_defs from "tools/registry")
(import build_model_request call_model from "models/gateway")
(import load_skill filter_tool_defs_for_skill infer_skill_name from "skills/loader")
(import memory_context extract_memory_from_run from "memory/store")
(import select_workflow start_workflow complete_workflow fail_workflow start_workflow_step complete_workflow_step fail_workflow_step from "workflows/engine")

(fn response_tool_calls [response]
  (if (response/tool_calls is Array)
    response/tool_calls
   else
    []
  )
)

(fn run_failed_tool [tool_result]
  ((tool_result/status || "ok") != "ok")
)

(fn $ns/already_completed_tool_calls [run_id tool_calls]
  (if tool_calls/.empty
    (return false)
  )
  (var completed {})
  (var events (events_for run_id))
  (var event_index 0)
  (while (event_index < events/.size)
    (var event (events .get event_index))
    (if (event/type == "tool.result")
      (var data (if (event/data is Map) event/data else {}))
      (var call_id (((data .get "call_id" "") || "") .to_s))
      (var status (((data .get "status" "") || "") .to_s))
      (if (call_id/.not_empty && (status == "ok"))
        (completed .set call_id true)
      )
    )
    (event_index += 1)
  )

  (var call_index 0)
  (while (call_index < tool_calls/.size)
    (var tool_call (tool_calls .get call_index))
    (var call_id (((tool_call/id || "") || "") .to_s))
    (if (call_id/.empty || ((completed .contains call_id) == false))
      (return false)
    )
    (call_index += 1)
  )
  true
)

(fn $ns/already_attempted_tool_calls [run_id tool_calls]
  (if tool_calls/.empty
    (return false)
  )
  (var attempted {})
  (var events (events_for run_id))
  (var event_index 0)
  (while (event_index < events/.size)
    (var event (events .get event_index))
    (var call_id "")
    (if (event/type == "tool.result")
      (var data (if (event/data is Map) event/data else {}))
      (call_id = (((data .get "call_id" "") || "") .to_s))
    )
    (if call_id/.not_empty
      (attempted .set call_id true)
    )
    (event_index += 1)
  )

  (var call_index 0)
  (while (call_index < tool_calls/.size)
    (var tool_call (tool_calls .get call_index))
    (var call_id (((tool_call/id || "") || "") .to_s))
    (if (call_id/.empty || ((attempted .contains call_id) == false))
      (return false)
    )
    (call_index += 1)
  )
  true
)

(fn tool_result_text_value [result]
  (var data (if (result is Map) result else {}))
  (var keys ["output" "content" "text" "value"])
  (var index 0)
  (while (index < keys/.size)
    (var key (keys .get index))
    (var value (((data .get key "") || "") .to_s))
    (if value/.not_empty
      (return value)
    )
    (index += 1)
  )
  ""
)

(fn gene_eval_final_content [tool_call result]
  (var code (((tool_call/args/code || "") || "") .to_s))
  (var output (tool_result_text_value result))
  (if code/.empty
    (return output)
  )
  (if output/.empty
    (return #"Gene code:\n```gene\n#{code}\n```")
  )
  #"Gene code:\n```gene\n#{code}\n```\n\nResult:\n#{output}"
)

(fn compact_line_text [text limit]
  (var value ((text || "") .to_s))
  (if (value/.size <= limit)
    (return value)
  )
  (var end_index (limit - 1))
  #"#{(value .substr 0 end_index)}...[truncated]"
)

(fn last_completed_tool_text [run_id]
  (var output "")
  (var events (events_for run_id))
  (var event_index 0)
  (while (event_index < events/.size)
    (var event (events .get event_index))
    (if (event/type == "tool.result")
      (var data (if (event/data is Map) event/data else {}))
      (var status (((data .get "status" "") || "") .to_s))
      (var result (if (data/result is Map) data/result else {}))
      (var value (tool_result_text_value result))
      (if ((status == "ok") && value/.not_empty)
        (output = value)
      )
    )
    (event_index += 1)
  )
  output
)

(fn $ns/deduped_final_content [run_id content]
  (var text ((content || "") .to_s))
  (var output (last_completed_tool_text run_id))
  (if output/.not_empty output else text)
)

(fn $ns/repeated_tool_call_fallback_content [run_id]
  (var lines [])
  (var events (events_for run_id))
  (var event_index 0)
  (while (event_index < events/.size)
    (var event (events .get event_index))
    (if (event/type == "tool.result")
      (var data (if (event/data is Map) event/data else {}))
      (var tool (((data .get "tool" "tool") || "tool") .to_s))
      (var status (((data .get "status" "") || "") .to_s))
      (var result (if (data/result is Map) data/result else {}))
      (var value (tool_result_text_value result))
      (if (status == "ok")
        (if value/.not_empty
          (lines .append #"#{tool} returned #{(compact_line_text value 240)}")
         else
          (lines .append #"#{tool} returned no output")
        )
       else
        (var error_text (((result .get "error" "") || "") .to_s))
        (if error_text/.empty
          (error_text = (tool_result_text_value result))
        )
        (if error_text/.empty
          (error_text = "failed")
        )
        (lines .append #"#{tool} failed: #{(compact_line_text error_text 240)}")
      )
    )
    (event_index += 1)
  )
  (if lines/.empty
    (return "Those tool calls already ran, but no final answer was generated.")
  )
  #"The model repeated tool calls that were already attempted. Using recorded tool results:\n\nTool results:\n- #{(lines .join "\n- ")}"
)

(fn $ns/repeated_tool_call_final_content [run_id content]
  (var text ((content || "") .to_s))
  (if text/.not_empty
    (return text)
  )
  (var fallback_lines [])
  (var events (events_for run_id))
  (var event_index 0)
  (while (event_index < events/.size)
    (var event (events .get event_index))
    (if (event/type == "tool.result")
      (var data (if (event/data is Map) event/data else {}))
      (var tool (((data .get "tool" "tool") || "tool") .to_s))
      (var status (((data .get "status" "") || "") .to_s))
      (var result (if (data/result is Map) data/result else {}))
      (var value (tool_result_text_value result))
      (if (status == "ok")
        (if value/.not_empty
          (fallback_lines .append #"#{tool} returned #{(compact_line_text value 240)}")
         else
          (fallback_lines .append #"#{tool} returned no output")
        )
       else
        (var error_text (((result .get "error" "") || "") .to_s))
        (if error_text/.empty
          (error_text = (tool_result_text_value result))
        )
        (if error_text/.empty
          (error_text = "failed")
        )
        (fallback_lines .append #"#{tool} failed: #{(compact_line_text error_text 240)}")
      )
    )
    (event_index += 1)
  )
  (var fallback_text (if fallback_lines/.empty
    "Those tool calls already ran, but no final answer was generated."
   else
    #"The model repeated tool calls that were already attempted. Using recorded tool results:\n\nTool results:\n- #{(fallback_lines .join "\n- ")}"
  ))
  (var final_text (deduped_final_content run_id text))
  (if final_text/.not_empty
    (return final_text)
  )
  fallback_text
)

(fn $ns/volatile_filesystem_goal [goal]
  (var text ((((goal || "") .to_s) .trim) .to_lower))
  (if text/.empty
    (return false)
  )
  (if ((text .contains "current dir") || (text .contains "current directory") || (text .contains "cwd") || (text == "pwd"))
    (return true)
  )
  (if ((text .contains "list files") || (text .contains "list file") || (text .contains "show files") || (text .contains "files in"))
    (return true)
  )
  false
)

(fn write_run_memory [run final_text]
  (if (volatile_filesystem_goal run/goal)
    (append_event run/id "memory.skipped" {^reason "volatile filesystem query"})
   else
    (extract_memory_from_run run {} final_text)
    (append_event run/id "memory.written" {})
  )
)

(fn $ns/run_agent_with_options [goal session budgets options]
  (var run_options (if (options is Map) options else {}))
  (var run (create_run goal session budgets))
  (transition_run run/id "running")
  (var step_count 0)
  (var tool_call_count 0)
  (var stop_loop false)
  (var provider (((run_options .get "provider" "") || "") .to_s))
  (var requested_skill (((run_options/skill || "") .to_s) .trim))
  (var resolved_skill (if requested_skill/.not_empty requested_skill else (infer_skill_name goal)))
  (var skill (if resolved_skill/.not_empty (load_skill resolved_skill) else nil))
  (var skill_inferred (requested_skill/.empty && (skill != nil)))
  (var workflow (select_workflow skill (run_options/workflow || "")))
  (var workflow_state (start_workflow run/id workflow))

  (if (skill != nil)
    (append_event run/id "skill.loaded" {
      ^name skill/name
      ^version skill/version
      ^workflow_count skill/workflows/.size
      ^tool_count skill/tools/.size
      ^inferred skill_inferred
    })
  )
  (var memory_skipped (volatile_filesystem_goal run/goal))
  (start_workflow_step run/id workflow_state "memory" "memory" {^limit 5 ^skipped memory_skipped})
  (var retrieved_memory {^count 0 ^text ""})
  (if_not memory_skipped
    (retrieved_memory = (memory_context run/goal run/session 5))
  )
  (append_event run/id "memory.retrieved" {
    ^count retrieved_memory/count
    ^text retrieved_memory/text
    ^skipped memory_skipped
  })
  (complete_workflow_step run/id workflow_state {^count retrieved_memory/count ^skipped memory_skipped})

  (loop
    (if (stop_loop || (terminal_run_state run/state))
      (break)
    )
    (if (step_count >= run/budgets/steps)
      (fail_workflow run/id workflow_state "step budget exceeded")
      (transition_run run/id "timed_out" {^reason "step budget exceeded"})
      (break)
    )
    (if (deadline_exceeded run/deadline_at_ms)
      (fail_workflow run/id workflow_state "deadline exceeded")
      (transition_run run/id "timed_out" {^reason "deadline exceeded"})
      (break)
    )

    (step_count += 1)
    (var available_tools (filter_tool_defs_for_skill (tool_defs) skill))
    (var request (build_model_request provider run (events_for run/id) available_tools {
      ^profile (run_options/profile || "")
      ^model (run_options/model || "")
      ^skill (if (skill == nil) "" else skill/name)
      ^system (if (skill == nil) "" else skill/system)
      ^memory_text retrieved_memory/text
    }))
    (start_workflow_step run/id workflow_state "model" "model" {^step step_count ^provider request/provider})
    (append_event run/id "model.request" {
      ^step step_count
      ^provider request/provider
      ^profile request/profile
      ^model request/model
      ^skill request/skill
      ^tool_count request/tools/.size
    })
    (var response (call_model request/provider request))
    (if (response/ok == false)
      (var error_info (response .get "error_info" {}))
      (var raw_model_error (response .get "error" nil))
      (var model_error (if (raw_model_error == nil) "" else raw_model_error/.to_s))
      (if model_error/.empty
        (var info_message (if (error_info is Map) ((error_info .get "message" "") .to_s) else ""))
        (if info_message/.not_empty
          (model_error = info_message)
         else
          (model_error = "model failed")
        )
      )
      (fail_workflow_step run/id workflow_state model_error)
      (fail_workflow run/id workflow_state model_error)
      (append_event run/id "model.error" {
        ^step step_count
        ^provider request/provider
        ^error model_error
        ^error_info error_info
        ^started_at_ms (response .get "started_at_ms" 0)
        ^completed_at_ms (response .get "completed_at_ms" 0)
        ^duration_ms (response .get "duration_ms" 0)
      })
      (fail_run run/id model_error)
      (break)
    )
    (append_event run/id "model.response" {
      ^step step_count
      ^provider request/provider
      ^kind (response .get "kind")
      ^content (response .get "content")
      ^tool_calls (response_tool_calls response)
      ^started_at_ms (response .get "started_at_ms" 0)
      ^completed_at_ms (response .get "completed_at_ms" 0)
      ^duration_ms (response .get "duration_ms" 0)
    })
    (var response_kind ((response .get "kind" "") .to_s))
    (var response_content ((response .get "content" "") .to_s))
    (var response_duration (response .get "duration_ms" 0))
    (complete_workflow_step run/id workflow_state {^kind response_kind ^duration_ms response_duration})

    (if (response_kind == "final")
      (start_workflow_step run/id workflow_state "finalize" "final" {^step step_count})
      (complete_run run/id response_content)
      (write_run_memory run response_content)
      (complete_workflow_step run/id workflow_state {^state "completed"})
      (complete_workflow run/id workflow_state {^state "completed"})
      (break)
    )

    (if (response_kind != "tool_calls")
      (var reason #"Unknown model response kind: #{response_kind}")
      (fail_workflow run/id workflow_state reason)
      (fail_run run/id reason)
      (break)
    )

    (var requested_tool_calls (response_tool_calls response))
    (if (already_attempted_tool_calls run/id requested_tool_calls)
      (var repeated_final (if (response_kind == "final") response_content else ""))
      (if repeated_final/.empty
        (var final_instruction "Produce a final answer from the previous tool results. Do not call tools; no tools are available for this finalization step.")
        (var final_system (if (skill == nil)
          final_instruction
         else
          #"#{skill/system}\n#{final_instruction}"
        ))
        (var final_request (build_model_request provider run (events_for run/id) [] {
          ^profile (run_options/profile || "")
          ^model (run_options/model || "")
          ^skill (if (skill == nil) "" else skill/name)
          ^system final_system
          ^memory_text retrieved_memory/text
        }))
        (start_workflow_step run/id workflow_state "model_final" "model" {^step step_count ^provider final_request/provider ^deduped_tool_calls requested_tool_calls/.size})
        (append_event run/id "model.request" {
          ^step step_count
          ^provider final_request/provider
          ^profile final_request/profile
          ^model final_request/model
          ^skill final_request/skill
          ^tool_count final_request/tools/.size
          ^final_attempt true
        })
        (var final_response (call_model final_request/provider final_request))
        (if (final_response/ok == false)
          (var final_error_info (final_response .get "error_info" {}))
          (var raw_final_error (final_response .get "error" nil))
          (var final_error (if (raw_final_error == nil) "" else raw_final_error/.to_s))
          (if final_error/.empty
            (var final_info_message (if (final_error_info is Map) ((final_error_info .get "message" "") .to_s) else ""))
            (if final_info_message/.not_empty
              (final_error = final_info_message)
             else
              (final_error = "model failed")
            )
          )
          (append_event run/id "model.error" {
            ^step step_count
            ^provider final_request/provider
            ^error final_error
            ^error_info final_error_info
            ^started_at_ms (final_response .get "started_at_ms" 0)
            ^completed_at_ms (final_response .get "completed_at_ms" 0)
            ^duration_ms (final_response .get "duration_ms" 0)
            ^final_attempt true
          })
          (complete_workflow_step run/id workflow_state {^kind "fallback" ^error final_error})
         else
          (append_event run/id "model.response" {
            ^step step_count
            ^provider final_request/provider
            ^kind (final_response .get "kind")
            ^content (final_response .get "content")
            ^tool_calls (response_tool_calls final_response)
            ^started_at_ms (final_response .get "started_at_ms" 0)
            ^completed_at_ms (final_response .get "completed_at_ms" 0)
            ^duration_ms (final_response .get "duration_ms" 0)
            ^final_attempt true
          })
          (var final_response_kind ((final_response .get "kind" "") .to_s))
          (var final_response_content ((final_response .get "content" "") .to_s))
          (if ((final_response_kind == "final") && final_response_content/.not_empty)
            (repeated_final = final_response_content)
          )
          (complete_workflow_step run/id workflow_state {^kind final_response_kind ^duration_ms (final_response .get "duration_ms" 0)})
        )
      )
      (if repeated_final/.empty
        (repeated_final = (repeated_tool_call_fallback_content run/id))
      )
      (if repeated_final/.not_empty
        (start_workflow_step run/id workflow_state "finalize" "final" {^step step_count ^deduped_tool_calls requested_tool_calls/.size ^attempted true})
        (complete_run run/id repeated_final)
        (write_run_memory run repeated_final)
        (complete_workflow_step run/id workflow_state {^state "completed" ^deduped_tool_calls requested_tool_calls/.size ^attempted true})
        (complete_workflow run/id workflow_state {^state "completed"})
       else
        (var repeated_error "model repeated prior tool calls without final content")
        (fail_workflow run/id workflow_state repeated_error)
        (fail_run run/id repeated_error)
      )
      (break)
    )
    (if (already_completed_tool_calls run/id requested_tool_calls)
      (start_workflow_step run/id workflow_state "finalize" "final" {^step step_count ^deduped_tool_calls requested_tool_calls/.size})
      (var final_content (deduped_final_content run/id response_content))
      (complete_run run/id final_content)
      (write_run_memory run final_content)
      (complete_workflow_step run/id workflow_state {^state "completed" ^deduped_tool_calls requested_tool_calls/.size})
      (complete_workflow run/id workflow_state {^state "completed"})
      (break)
    )
    (var tool_index 0)
    (var tool_batch_failed false)
    (var tool_batch_error "")
    (var tool_batch_failed_count 0)
    (var gene_eval_final "")
    (start_workflow_step run/id workflow_state "tool_batch" "tools" {^step step_count ^tool_call_count requested_tool_calls/.size})
    (while (tool_index < requested_tool_calls/.size)
      (var tool_call (requested_tool_calls .get tool_index))
      (if (tool_call_count >= run/budgets/tool_calls)
        (tool_batch_failed = true)
        (tool_batch_error = "tool call budget exceeded")
        (fail_run run/id tool_batch_error)
        (stop_loop = true)
        (break)
      )
      (tool_call_count += 1)
      (var result (invoke_tool run/id tool_call/name tool_call/args {^call_id tool_call/id}))
      (if (run_failed_tool result)
        (tool_batch_failed_count += 1)
       elif (tool_call/name == "gene.eval")
        (var final_text (gene_eval_final_content tool_call result))
        (if final_text/.not_empty
          (gene_eval_final = final_text)
        )
      )
      (tool_index += 1)
    )
    (if tool_batch_failed
      (fail_workflow_step run/id workflow_state tool_batch_error)
      (fail_workflow run/id workflow_state tool_batch_error)
     else
      (complete_workflow_step run/id workflow_state {^executed tool_index ^failed tool_batch_failed_count})
    )

    (if stop_loop
      (break)
    )

    (if (gene_eval_final/.not_empty && (requested_tool_calls/.size == 1))
      (start_workflow_step run/id workflow_state "finalize" "final" {^step step_count ^source "gene.eval"})
      (complete_run run/id gene_eval_final)
      (write_run_memory run gene_eval_final)
      (complete_workflow_step run/id workflow_state {^state "completed" ^source "gene.eval"})
      (complete_workflow run/id workflow_state {^state "completed" ^source "gene.eval"})
      (break)
    )
  )

  (run_summary run/id)
)

(fn $ns/run_agent [goal session = "local" budgets = {}]
  (run_agent_with_options goal session budgets {})
)
