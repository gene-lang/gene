# Trusted-local built-in tools for the GeneClaw tool runtime slice.

(import register_tool from "tools/registry")

(fn default_workspace_root []
  (var value (((($env .get "GENECLAW_WORKSPACE_ROOT" "") || "") .to_s) .trim))
  (if value/.not_empty
    (return value)
  )
  (value = (((($env .get "GENECLAW_NEW_HOME" "") || "") .to_s) .trim))
  (if value/.not_empty
    (return value)
  )
  (((($env .get "PWD" ".") || ".") .to_s) .trim)
)

($ns/WORKSPACE_ROOT = (default_workspace_root))

(fn $ns/set_workspace_root [path]
  (WORKSPACE_ROOT = (((path || ".") .to_s) .trim))
  WORKSPACE_ROOT
)

(fn $ns/workspace_root []
  WORKSPACE_ROOT
)

(fn relative_path_error [path]
  (var text ((path || "") .to_s))
  (if text/.empty
    "Missing path"
  elif ((text .starts_with "/") || (text .starts_with "~"))
    "Path must be relative to the workspace"
  elif (text .contains "..")
    "Path traversal not allowed"
  else
    ""
  )
)

(fn full_path [path]
  #"#{WORKSPACE_ROOT}/#{path}"
)

(fn workspace_relative_path [path]
  (var text (((path || "") .to_s) .trim))
  (if text/.empty
    (return text)
  )
  (if (text == WORKSPACE_ROOT)
    (return ".")
  )
  (var prefix #"#{WORKSPACE_ROOT}/")
  (if (text .starts_with prefix)
    (var rel (text .replace_all prefix ""))
    (if rel/.empty "." else rel)
   else
    text
  )
)

(fn web_helper_path []
  ($env .get "GENECLAW_WEB_HELPER" "scripts/web_tools.py")
)

(fn int_text [value fallback]
  (var source value)
  (if (source == nil)
    (source = fallback)
  )
  (var parsed (try (source/.to_s .to_i) catch * fallback))
  parsed/.to_s
)

(fn parse_web_helper_result [process_result fallback_error]
  (var output ((process_result/output || "") .to_s))
  (if ((process_result/exit_code || 0) != 0)
    (return {^status "failed" ^error #"#{fallback_error}: #{output}" ^output output})
  )
  (try
    (var parsed (gene/json/parse output))
    (if (parsed is Map)
      (if (((parsed/status || "") .to_s) .empty)
        (parsed .set "status" "ok")
      )
      (return parsed)
    )
    {^status "failed" ^error #"#{fallback_error}: helper returned non-object JSON" ^output output}
   catch *
    {^status "failed" ^error #"#{fallback_error}: #{$ex/message}" ^output output}
  )
)

(fn shell_cwd_path [cwd]
  (var text (((cwd || ".") .to_s) .trim))
  (if text/.empty
    (return (full_path "."))
  )
  (if (text .starts_with "~")
    (var home ($env .get "HOME" ""))
    (var suffix (text .replace_all "~" ""))
    (return #"#{home}#{suffix}")
  )
  (if ((text == "$HOME") || (text .starts_with "$HOME/"))
    (var home ($env .get "HOME" ""))
    (var suffix (text .replace_all "$HOME" ""))
    (return #"#{home}#{suffix}")
  )
  (if ((text == "${HOME}") || (text .starts_with "${HOME}/"))
    (var home ($env .get "HOME" ""))
    (var suffix (text .replace_all "${HOME}" ""))
    (return #"#{home}#{suffix}")
  )
  (if (text .starts_with "/")
    (return text)
  )
  (full_path text)
)

(fn shell_run [args]
  (var cmd (((args/cmd || "") .to_s) .trim))
  (if cmd/.empty
    (return {^status "failed" ^error "Missing cmd"})
  )
  (var cwd (((args/cwd || ".") .to_s) .trim))
  (var timeout_ms (try ((args/timeout_ms || 0) .to_i) catch * 0))
  (try
    (var cwd_path (shell_cwd_path cwd))
    (var result (if (timeout_ms > 0)
      (system/run "sh" "-lc" cmd ^cwd cwd_path ^timeout (timeout_ms / 1000.0) ^stderr_to_stdout true)
    else
      (system/run "sh" "-lc" cmd ^cwd cwd_path ^stderr_to_stdout true)
    ))
    {
      ^status (if ((result/timed_out == true) || (result/exit_code != 0)) "failed" else "ok")
      ^exit_code result/exit_code
      ^cwd cwd
      ^timeout_ms timeout_ms
      ^timeout_enforced (timeout_ms > 0)
      ^timed_out (result/timed_out == true)
      ^stderr (result/stderr || "")
      ^output (result/output || "")
    }
  catch *
    {^status "failed" ^error #"shell failed: #{$ex/message}"}
  )
)

(fn web_search [args]
  (var query (((args/query || "") .to_s) .trim))
  (if query/.empty
    (return {^status "failed" ^error "Missing query"})
  )
  (var provider ((((args .get "provider" ($env .get "GENECLAW_SEARCH_PROVIDER" "mojeek")) || "mojeek") .to_s) .trim))
  (var limit_text (int_text (args .get "limit" 5) 5))
  (var timeout_text (int_text (args .get "timeout_ms" 15000) 15000))
  (try
    (var result (system/run "python3" (web_helper_path) "search"
      ^env {
        ^GENECLAW_WEB_QUERY query
        ^GENECLAW_SEARCH_PROVIDER provider
        ^GENECLAW_WEB_LIMIT limit_text
        ^GENECLAW_WEB_TIMEOUT_MS timeout_text
        ^GENECLAW_WEB_SEARCH_FIXTURE ($env .get "GENECLAW_WEB_SEARCH_FIXTURE" "")
      }
      ^stderr_to_stdout true))
    (parse_web_helper_result result "web search failed")
   catch *
    {^status "failed" ^error #"web search failed: #{$ex/message}"}
  )
)

(fn web_fetch [args]
  (var url (((args/url || "") .to_s) .trim))
  (if url/.empty
    (return {^status "failed" ^error "Missing url"})
  )
  (var timeout_text (int_text (args .get "timeout_ms" 15000) 15000))
  (try
    (var result (system/run "python3" (web_helper_path) "fetch"
      ^env {
        ^GENECLAW_WEB_URL url
        ^GENECLAW_WEB_TIMEOUT_MS timeout_text
        ^GENECLAW_WEB_FETCH_FIXTURE ($env .get "GENECLAW_WEB_FETCH_FIXTURE" "")
      }
      ^stderr_to_stdout true))
    (parse_web_helper_result result "web fetch failed")
   catch *
    {^status "failed" ^error #"web fetch failed: #{$ex/message}"}
  )
)

(fn web_read [args]
  (var url (((args/url || "") .to_s) .trim))
  (if url/.empty
    (return {^status "failed" ^error "Missing url"})
  )
  (var timeout_text (int_text (args .get "timeout_ms" 15000) 15000))
  (try
    (var result (system/run "python3" (web_helper_path) "read"
      ^env {
        ^GENECLAW_WEB_URL url
        ^GENECLAW_WEB_TIMEOUT_MS timeout_text
        ^GENECLAW_WEB_FETCH_FIXTURE ($env .get "GENECLAW_WEB_FETCH_FIXTURE" "")
      }
      ^stderr_to_stdout true))
    (parse_web_helper_result result "web read failed")
   catch *
    {^status "failed" ^error #"web read failed: #{$ex/message}"}
  )
)

(fn file_read [args]
  (var path (workspace_relative_path (args/path || "")))
  (var path_error (relative_path_error path))
  (if path_error/.not_empty
    (return {^status "failed" ^error path_error})
  )
  (try
    {^status "ok" ^path path ^content (gene/io/read (full_path path))}
  catch *
    {^status "failed" ^error #"Cannot read: #{$ex/message}"}
  )
)

(fn search_rg [args]
  (var pattern (((args/pattern || "") .to_s) .trim))
  (var path (workspace_relative_path (args/path || ".")))
  (if pattern/.empty
    (return {^status "failed" ^error "Missing pattern"})
  )
  (var path_error (relative_path_error path))
  (if path_error/.not_empty
    (return {^status "failed" ^error path_error})
  )
  (try
    (var result (system/run "rg" pattern (full_path path) "--max-count" "50" ^stderr_to_stdout true))
    (var exit_code (result/exit_code || 0))
    (var output (result/output || ""))
    (if (exit_code > 1)
      (return {^status "failed" ^pattern pattern ^path path ^exit_code exit_code ^error output ^output output})
    )
    {^status "ok" ^pattern pattern ^path path ^exit_code exit_code ^output output}
  catch *
    {^status "failed" ^error #"search failed: #{$ex/message}"}
  )
)

(fn file_patch [args]
  (var path (workspace_relative_path (args/path || "")))
  (var diff ((args/diff || "") .to_s))
  (var path_error (relative_path_error path))
  (if path_error/.not_empty
    (return {^status "failed" ^error path_error})
  )
  (if diff/.empty
    (return {^status "failed" ^error "Missing diff"})
  )
  (try
    (var tmp_path #"/tmp/geneclaw-new-patch-#{gene/now/.call/.to_i}.diff")
    (gene/io/write tmp_path diff)
    (var result (system/shell #"cd '#{WORKSPACE_ROOT}' && patch -p0 '#{path}' < '#{tmp_path}'"))
    (system/shell #"rm -f '#{tmp_path}'")
    (if (result/exit_code != 0)
      {^status "failed" ^error #"patch failed: #{result/output}" ^output (result/output || "")}
    else
      {^status "ok" ^path path ^output (result/output || "")}
    )
  catch *
    {^status "failed" ^error #"patch failed: #{$ex/message}"}
  )
)

(fn $ns/register_builtin_tools []
  (register_tool
    "shell.run"
    "Run a local shell command in the trusted operator environment. The shell is macOS/POSIX; prefer portable commands and avoid GNU-only flags such as find -printf."
    {^type "object"
     ^required ["cmd"]
     ^properties {
       ^cmd {^type "string"}
       ^cwd {^type "string"}
       ^timeout_ms {^type "integer"}
       ^max_output_bytes {^type "integer"}
     }}
    {^status "String" ^exit_code "Int" ^cwd "String" ^timeout_ms "Int" ^timeout_enforced "Bool" ^output "String"}
    shell_run)
  (register_tool
    "file.read"
    "Read a workspace-relative file."
    {^type "object" ^required ["path"] ^properties {^path {^type "string"} ^max_output_bytes {^type "integer"}}}
    {^status "String" ^path "String" ^content "String"}
    file_read)
  (register_tool
    "search.rg"
    "Search workspace files with ripgrep."
    {^type "object" ^required ["pattern"] ^properties {^pattern {^type "string"} ^path {^type "string"} ^max_output_bytes {^type "integer"}}}
    {^status "String" ^pattern "String" ^path "String" ^output "String"}
    search_rg)
  (register_tool
    "file.patch"
    "Apply a unified diff to a workspace-relative file."
    {^type "object" ^required ["path" "diff"] ^properties {^path {^type "string"} ^diff {^type "string"} ^max_output_bytes {^type "integer"}}}
    {^status "String" ^path "String" ^output "String"}
    file_patch)
  (register_tool
    "web.search"
    "Search the web and return structured results. Defaults to Mojeek HTML search unless GENECLAW_SEARCH_PROVIDER or a fixture is configured."
    {^type "object"
     ^required ["query"]
     ^properties {
       ^query {^type "string"}
       ^provider {^type "string"}
       ^limit {^type "integer"}
       ^timeout_ms {^type "integer"}
       ^max_output_bytes {^type "integer"}
     }}
    {^status "String" ^provider "String" ^query "String" ^results "Array" ^output "String"}
    web_search)
  (register_tool
    "web.fetch"
    "Fetch a URL and return raw content plus HTTP metadata."
    {^type "object"
     ^required ["url"]
     ^properties {
       ^url {^type "string"}
       ^timeout_ms {^type "integer"}
       ^max_output_bytes {^type "integer"}
     }}
    {^status "String" ^url "String" ^final_url "String" ^status_code "Int" ^content_type "String" ^content "String"}
    web_fetch)
  (register_tool
    "web.read"
    "Fetch a URL and return readable text, title, and links extracted from HTML."
    {^type "object"
     ^required ["url"]
     ^properties {
       ^url {^type "string"}
       ^timeout_ms {^type "integer"}
       ^max_output_bytes {^type "integer"}
     }}
    {^status "String" ^url "String" ^final_url "String" ^source_url "String" ^title "String" ^text "String" ^links "Array"}
    web_read)
  true
)
