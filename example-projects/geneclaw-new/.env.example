GENECLAW_NEW_HOME=/tmp/geneclaw-new

GENECLAW_MODEL_LIVE=false

# Web tool defaults. `mojeek` works without an API key in local use; tests can
# set fixtures with GENECLAW_WEB_SEARCH_FIXTURE and GENECLAW_WEB_FETCH_FIXTURE.
GENECLAW_SEARCH_PROVIDER=mojeek

# Defaults used by plain `gene run src/main.gene run ...`.
#GENECLAW_PROVIDER=openai
#GENECLAW_PROFILE=standard
#GENECLAW_MODEL=gpt-5.4-mini

#OPENAI_API_KEY=
#OPENAI_AUTH_TOKEN=
#OPENAI_MODEL=gpt-5.4-mini
#OPENAI_BASE_URL=
#OPENAI_ACCOUNT_ID=
#OPENAI_TIMEOUT_MS=

#ANTHROPIC_API_KEY=
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_MODEL=
#ANTHROPIC_BASE_URL=
#ANTHROPIC_TIMEOUT_MS=

#GENECLAW_FAST_MODEL=
#GENECLAW_STANDARD_MODEL=
#GENECLAW_FRONTIER_MODEL=
#GENECLAW_VISION_MODEL=
#GENECLAW_CODE_MODEL=
# Matching providers for models above
#GENECLAW_*_PROVIDER
