#!/usr/bin/env gene run

(import reset_runs from "kernel/runs")
(import set_store_root from "kernel/storage")
(import reset_tools from "tools/registry")
(import register_fake_tools from "tools/fake")
(import run_agent from "agent_loop")
(import tui_color_enabled tui_colorize tui_prompt tui_prompt_text tui_response_text tui_program_text tui_child_output_text tui_child_display_text tui_exit_command tui_shell_quote tui_run_shell_command tui_new_run_id tui_run_goal tui_run_view tui_dashboard render_tui_run_view render_tui_dashboard from "channels/tui")

($env .set "GENECLAW_MODEL_LIVE" "false")
($env .set "GENECLAW_PROVIDER" "")
($env .set "GENECLAW_PROFILE" "")
($env .set "GENECLAW_MODEL" "")
($env .set "GENECLAW_DEFAULT_PROVIDER" "")
($env .set "GENECLAW_DEFAULT_PROFILE" "")
($env .set "GENECLAW_DEFAULT_MODEL" "")
($env .set "GENECLAW_NEW_HOME" "/tmp/geneclaw-new-test-tui-store")
($env .set "GENECLAW_GENE_BIN" "../../bin/gene")

(set_store_root "/tmp/geneclaw-new-test-tui-store")
(reset_runs)
(reset_tools)
(register_fake_tools)

(var summary (run_agent "review tui path" "tui-session" {^steps 4 ^tool_calls 2}))
(assert (summary/state == "completed"))

(var run_view (tui_run_view summary/id 5))
(assert (run_view/ok == true))
(assert (run_view/summary/id == summary/id))
(assert (run_view/events/.size <= 5))
(assert (run_view/events/.size > 0))
(var rendered_run (render_tui_run_view run_view))
(assert (rendered_run .contains summary/id))
(assert (rendered_run .contains "Events"))

(var missing_view (tui_run_view "missing-run" 5))
(assert (missing_view/ok == false))
(assert ((render_tui_run_view missing_view) .contains "Run not found"))

(var dashboard (tui_dashboard [summary/id] "tui"))
(assert (dashboard/runs/.size == 1))
(assert (dashboard/runs/0/id == summary/id))
(assert (dashboard/runs/0/event_count > 0))
(assert (dashboard/memory/.size == 1))
(var rendered_dashboard (render_tui_dashboard dashboard))
(assert (rendered_dashboard .contains "Runs"))
(assert (rendered_dashboard .contains summary/id))
(assert (rendered_dashboard .contains "Memory: 1"))

(assert (tui_exit_command "/quit"))
(assert (tui_exit_command " /exit "))
(assert ((tui_exit_command "quit") == false))
($env .set "GENECLAW_TUI_COLOR" "never")
(assert ((tui_color_enabled) == false))
(assert ((tui_prompt) == "geneclaw 002> "))
(assert ((tui_prompt_text (tui_prompt)) == "geneclaw 002> "))
($env .set "GENECLAW_TUI_COLOR" "always")
($env .set "NO_COLOR" "")
(assert (tui_color_enabled))
(var colored_prompt (tui_prompt_text (tui_prompt)))
(var colored_response (tui_response_text "bye"))
(var colored_program (tui_program_text "log"))
(var colored_child_response (tui_child_output_text "run-1 completed: Done"))
(var shell_child_output (tui_child_display_text "!ls" "run-73 completed: daemon"))
(var code_child_output (tui_child_display_text "(var a 1) (a + 2)" "run-77 completed: 3"))
(var colored_child_output (tui_child_output_text "tool stdout"))
(assert ((tui_colorize "36" "x") .contains "[36m"))
(assert (colored_prompt .contains "[36m"))
(assert (colored_prompt .contains "geneclaw 002> "))
(assert (colored_response .contains "[32m"))
(assert (colored_program .contains "[90m"))
(assert (colored_child_response .contains "[32m"))
(assert (shell_child_output .contains "daemon"))
(assert ((shell_child_output .contains "completed") == false))
(assert (code_child_output .contains "3"))
(assert ((code_child_output .contains "completed") == false))
(assert (colored_child_output .contains "[90m"))
($env .set "GENECLAW_TUI_COLOR" "never")
(assert ((tui_prompt_text (tui_prompt)) == "geneclaw 002> "))
($env .set "GENECLAW_TUI_COLOR" "")
(assert ((tui_shell_quote "hello world") == "'hello world'"))
(assert ((tui_shell_quote "a'b") == "'a'\"'\"'b'"))
(assert ((tui_shell_quote "$HOME") == "'$HOME'"))

(var command (tui_run_shell_command "hello tui" {^steps 3 ^tool_calls 2} {^provider "fake" ^profile "fast"}))
(assert (command .contains "'../../bin/gene' run src/main.gene run"))
(assert (command .contains "--provider 'fake'"))
(assert (command .contains "--profile 'fast'"))
(assert (command .contains "--steps '3'"))
(assert (command .contains "'hello tui'"))

(assert ((tui_new_run_id ["run-1" "run-3"] ["run-1" "run-3" "run-4"]) == "run-4"))
(assert ((tui_new_run_id ["run-1"] ["run-1"]) == ""))

(var subprocess_result (tui_run_goal "review tui subprocess" {} {^provider "fake"}))
(assert (subprocess_result/status == "completed"))
(assert (subprocess_result/exit_code == 0))
(assert (subprocess_result/run_id .not_empty))

(println "ok")
