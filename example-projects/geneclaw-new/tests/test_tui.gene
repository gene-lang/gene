#!/usr/bin/env gene run

(import reset_runs from "kernel/runs")
(import set_store_root store_root from "kernel/storage")
(import reset_tools from "tools/registry")
(import register_fake_tools from "tools/fake")
(import register_builtin_tools from "tools/builtin")
(import register_code_eval_tools from "code_eval")
(import run_agent from "agent_loop")
(import tui_color_enabled tui_colorize tui_prompt tui_prompt_text tui_response_text tui_program_text tui_child_output_text tui_child_display_text tui_exit_command tui_slash_command tui_help_text tui_handle_slash_command tui_prompt_preview tui_shell_quote tui_run_shell_command tui_new_run_id tui_next_run_number tui_run_goal tui_run_view tui_dashboard render_tui_run_view render_tui_dashboard from "channels/tui")

($env .set "GENECLAW_MODEL_LIVE" "false")
($env .set "GENECLAW_PROVIDER" "")
($env .set "GENECLAW_PROFILE" "")
($env .set "GENECLAW_MODEL" "")
($env .set "GENECLAW_DEFAULT_PROVIDER" "")
($env .set "GENECLAW_DEFAULT_PROFILE" "")
($env .set "GENECLAW_DEFAULT_MODEL" "")
($env .set "GENECLAW_NEW_HOME" "/tmp/geneclaw-new-test-tui-store")
($env .set "GENECLAW_GENE_BIN" "../../bin/gene")

(set_store_root "/tmp/geneclaw-new-test-tui-store")
(reset_runs)
(reset_tools)
(register_fake_tools)
(register_builtin_tools)
(register_code_eval_tools)

(var summary (run_agent "review tui path" "tui-session" {^steps 4 ^tool_calls 2}))
(assert (summary/state == "completed"))

(var run_view (tui_run_view summary/id 5))
(assert (run_view/ok == true))
(assert (run_view/summary/id == summary/id))
(assert (run_view/events/.size <= 5))
(assert (run_view/events/.size > 0))
(var rendered_run (render_tui_run_view run_view))
(assert (rendered_run .contains summary/id))
(assert (rendered_run .contains "Events"))

(var missing_view (tui_run_view "missing-run" 5))
(assert (missing_view/ok == false))
(assert ((render_tui_run_view missing_view) .contains "Run not found"))

(var dashboard (tui_dashboard [summary/id] "tui"))
(assert (dashboard/runs/.size == 1))
(assert (dashboard/runs/0/id == summary/id))
(assert (dashboard/runs/0/event_count > 0))
(assert (dashboard/memory/.size == 1))
(var rendered_dashboard (render_tui_dashboard dashboard))
(assert (rendered_dashboard .contains "Runs"))
(assert (rendered_dashboard .contains summary/id))
(assert (rendered_dashboard .contains "Memory: 1"))

(assert (tui_exit_command "/quit"))
(assert (tui_exit_command " /exit "))
(assert ((tui_exit_command "quit") == false))
(assert (tui_slash_command "/help"))
(assert ((tui_slash_command "help") == false))
(assert ((tui_help_text) .contains "/reset"))
(assert ((tui_help_text) .contains "/show-prompt"))
($env .set "GENECLAW_TUI_COLOR" "never")
(assert ((tui_color_enabled) == false))
(assert ((tui_prompt) == "0002\u203a "))
(assert ((tui_prompt_text (tui_prompt)) == "0002\u203a "))
($env .set "GENECLAW_TUI_COLOR" "always")
($env .set "NO_COLOR" "")
(assert (tui_color_enabled))
(var colored_prompt (tui_prompt_text (tui_prompt)))
(var colored_response (tui_response_text "bye"))
(var colored_program (tui_program_text "log"))
(var colored_child_response (tui_child_output_text "run-1 completed: Done"))
(var shell_child_output (tui_child_display_text "!ls" "run-73 completed: daemon"))
(var code_child_output (tui_child_display_text "(var a 1) (a + 2)" "run-77 completed: 3"))
(var agent_child_output (tui_child_display_text "hi" "run-1 completed: Hi! How can I help?"))
(var colored_child_output (tui_child_output_text "tool stdout"))
(assert ((tui_colorize "36" "x") .contains "[36m"))
(assert (colored_prompt .contains "[36m"))
(assert (colored_prompt .contains "0002\u203a "))
(assert (colored_response .contains "[32m"))
(assert (colored_program .contains "[90m"))
(assert (colored_child_response .contains "[32m"))
(assert (shell_child_output .contains "daemon"))
(assert ((shell_child_output .contains "completed") == false))
(assert ((shell_child_output .contains "\u2514") == false))
(assert (code_child_output .contains "3"))
(assert ((code_child_output .contains "completed") == false))
(assert ((code_child_output .contains "\u2514") == false))
(assert (agent_child_output .contains "Hi! How can I help?"))
(assert ((agent_child_output .contains "completed") == false))
(assert (colored_child_output .contains "[90m"))
($env .set "GENECLAW_TUI_COLOR" "never")
(assert ((tui_prompt_text (tui_prompt)) == "0002\u203a "))
($env .set "GENECLAW_TUI_COLOR" "")
(assert ((tui_shell_quote "hello world") == "'hello world'"))
(assert ((tui_shell_quote "a'b") == "'a'\"'\"'b'"))
(assert ((tui_shell_quote "$HOME") == "'$HOME'"))

(var command (tui_run_shell_command "hello tui" {^steps 3 ^tool_calls 2} {^provider "fake" ^profile "fast"}))
(assert (command .contains "'../../bin/gene' run src/main.gene run"))
(assert (command .contains "--provider 'fake'"))
(assert (command .contains "--profile 'fast'"))
(assert (command .contains "--steps '3'"))
(assert (command .contains "'hello tui'"))

(assert ((tui_new_run_id ["run-1" "run-3"] ["run-1" "run-3" "run-4"]) == "run-4"))
(assert ((tui_new_run_id ["run-1"] ["run-1"]) == ""))

(var subprocess_result (tui_run_goal "review tui subprocess" {} {^provider "fake"}))
(assert (subprocess_result/status == "completed"))
(assert (subprocess_result/exit_code == 0))
(assert (subprocess_result/run_id .not_empty))

(var multiline_result (tui_run_goal "(var multiline_a 1)\n(multiline_a + 2)" {} {}))
(assert (multiline_result/status == "completed"))
(assert (multiline_result/exit_code == 0))
(assert (multiline_result/run_id .not_empty))
(assert ((gene/serdes/serialize multiline_result/output) .contains "3"))

(var help_result (tui_handle_slash_command "/help"))
(assert (help_result/handled == true))
(assert (help_result/exit == false))
(assert (help_result/message .contains "/clear"))

(var unknown_result (tui_handle_slash_command "/nope"))
(assert (unknown_result/handled == true))
(assert (unknown_result/exit == false))
(assert (unknown_result/message .contains "unknown command"))

(var prompt_preview (tui_prompt_preview "write gene code to inspect the context"))
(assert (prompt_preview .contains "Prompt preview"))
(assert (prompt_preview .contains "Text: write gene code to inspect the context"))
(assert (prompt_preview .contains "Skill: gene-coding (inferred)"))
(assert (prompt_preview .contains "System:"))
(assert (prompt_preview .contains "gene.eval"))
(assert (prompt_preview .contains "User:"))
(assert (prompt_preview .contains "write gene code to inspect the context"))
(assert (prompt_preview .contains "Tools:\n- gene.eval"))
(assert (prompt_preview .contains "- gene.eval"))
(assert (prompt_preview .contains "- shell.run"))

(var plain_prompt_preview (tui_prompt_preview "test"))
(assert (plain_prompt_preview .contains "Prompt preview"))
(assert (plain_prompt_preview .contains "Text: test"))
(assert (plain_prompt_preview .contains "Skill: (none)"))
(assert (plain_prompt_preview .contains "System:"))
(assert (plain_prompt_preview .contains "You are GeneClaw"))
(assert (plain_prompt_preview .contains "User:"))
(assert (plain_prompt_preview .contains "test"))
(assert (plain_prompt_preview .contains "Tools:"))
(assert (plain_prompt_preview .contains "- shell.run"))

(var before_show_prompt_number (tui_next_run_number))
(var show_prompt_result (tui_handle_slash_command "/show-prompt write gene code to inspect the context"))
(assert (show_prompt_result/handled == true))
(assert (show_prompt_result/exit == false))
(assert (show_prompt_result/message .contains "Text: write gene code to inspect the context"))
(assert ((tui_next_run_number) == before_show_prompt_number))

(var before_plain_show_prompt_number (tui_next_run_number))
(var plain_show_prompt_result (tui_handle_slash_command "/show-prompt test"))
(assert (plain_show_prompt_result/handled == true))
(assert (plain_show_prompt_result/exit == false))
(assert (plain_show_prompt_result/message .contains "Text: test"))
(assert (plain_show_prompt_result/message .contains "Skill: (none)"))
(assert (plain_show_prompt_result/message .contains "System:"))
(assert (plain_show_prompt_result/message .contains "You are GeneClaw"))
(assert (plain_show_prompt_result/message .contains "User:"))
(assert (plain_show_prompt_result/message .contains "test"))
(assert (plain_show_prompt_result/message .contains "Tools:"))
(assert (plain_show_prompt_result/message .contains "- shell.run"))
(assert ((tui_next_run_number) == before_plain_show_prompt_number))

(var daemon_dir #"#{(store_root)}/daemon")
(system/shell #"mkdir -p '#{daemon_dir}'")
(gene/io/write #"#{daemon_dir}/geneclaw-new.log" "keep")

(var reset_result (tui_handle_slash_command "/reset"))
(assert (reset_result/handled == true))
(assert (reset_result/exit == false))
(assert (reset_result/message == "session reset"))
(assert ((tui_prompt) == "0001\u203a "))
(assert ((tui_next_run_number) == 1))
(var daemon_log_probe (system/run "test" "-f" #"#{daemon_dir}/geneclaw-new.log"))
(assert (daemon_log_probe/exit_code == 0))

(println "ok")
