#!/usr/bin/env gene run

(import reset_runs create_run from "kernel/runs")
(import append_event events_for has_event_type from "kernel/events")
(import set_store_root from "kernel/storage")
(import reset_tools tool_defs from "tools/registry")
(import register_fake_tools from "tools/fake")
(import genex/ai)
(import build_model_request build_provider_payload call_model normalize_openai_response normalize_anthropic_response error_message_from_response classify_model_error stream_event_from_delta restore_tool_call_names from "models/gateway")
(import model_live_enabled provider_status provider_has_credentials from "models/config")
(import resolve_model_profile from "models/profiles")

($env .set "GENECLAW_MODEL_LIVE" "")
($env .set "GENECLAW_PROVIDER" "")
($env .set "GENECLAW_PROFILE" "")
($env .set "GENECLAW_MODEL" "")
($env .set "GENECLAW_DEFAULT_PROVIDER" "")
($env .set "GENECLAW_DEFAULT_PROFILE" "")
($env .set "GENECLAW_DEFAULT_MODEL" "")
($env .set "OPENAI_API_KEY" "")
($env .set "OPENAI_AUTH_TOKEN" "")
($env .set "OPENAI_OAUTH_TOKEN" "")
($env .set "OPENAI_ACCOUNT_ID" "")

(set_store_root "/tmp/geneclaw-new-test-model-gateway")
(reset_runs)
(reset_tools)
(register_fake_tools)

(var run (create_run "gateway should call tools" "test"))
(var request (build_model_request "fake" run (events_for run/id) (tool_defs) {^profile "fake"}))
(assert (request/provider == "fake"))
(assert (request/profile == "fake"))
(assert (request/model == "fake"))
(assert (request/tool_names/.size == 2))
(assert (request/tool_name_map/fake_echo == "fake.echo"))
(assert (request/tools/.size == 2))
(assert (request/tools/0/type == "function"))

(var fast_profile (resolve_model_profile "" {^profile "fast"}))
(assert (fast_profile/profile == "fast"))
(assert (fast_profile/provider == "openai"))
(assert (fast_profile/model .not_empty))
(assert (fast_profile/capabilities/tools == true))

($env .set "GENECLAW_MODEL_LIVE" "true")
($env .set "OPENAI_MODEL" "gpt-env-default")
(var env_default_request (build_model_request "" run (events_for run/id) (tool_defs) {}))
(assert (env_default_request/provider == "openai"))
(assert (env_default_request/profile == "standard"))
(assert (env_default_request/model == "gpt-env-default"))
($env .set "GENECLAW_MODEL_LIVE" "")
($env .set "OPENAI_MODEL" "")

(var frontier_request (build_model_request "" run (events_for run/id) (tool_defs) {^profile "frontier"}))
(assert (frontier_request/provider == "openai"))
(assert (frontier_request/profile == "frontier"))
(assert (frontier_request/model .not_empty))

(var anthropic_profile_request (build_model_request "anthropic" run (events_for run/id) (tool_defs) {^profile "frontier"}))
(assert (anthropic_profile_request/provider == "anthropic"))
(assert (anthropic_profile_request/profile == "frontier"))
(assert (anthropic_profile_request/model .not_empty))

(var fake_response (call_model "fake" request))
(assert (fake_response/ok == true))
(assert (fake_response/provider == "fake"))
(assert (fake_response/kind == "tool_calls"))
(assert (fake_response/tool_calls/0/name == "fake.echo"))
(assert (fake_response/tool_calls/0/args/text == "gateway should call tools"))
(assert (fake_response/started_at_ms > 0))
(assert (fake_response/completed_at_ms >= fake_response/started_at_ms))
(assert (fake_response/duration_ms == (fake_response/completed_at_ms - fake_response/started_at_ms)))

(var openai_request (build_model_request "openai" run (events_for run/id) (tool_defs) {^model "gpt-test"}))
(var openai_payload (build_provider_payload "openai" openai_request))
(assert (openai_payload/model == "gpt-test"))
(assert (openai_payload/messages/0/role == "system"))
(assert (openai_payload/messages/1/content == "gateway should call tools"))
(assert (openai_payload/instructions .contains "You are GeneClaw."))
(assert (openai_payload/instructions .contains "default shell cwd"))
(assert (openai_payload/instructions .contains "do not answer from memory alone"))
(assert (openai_payload/instructions .contains "macOS/POSIX"))
(assert (openai_payload/instructions .contains "trailing slash"))
(assert (openai_payload/input/0/type == "message"))
(assert (openai_payload/input/0/role == "user"))
(assert (openai_payload/input/0/content == "gateway should call tools"))
(assert (openai_payload/tools/0/type == "function"))
(assert (openai_payload/tools/0/function/name == "fake_echo"))

($env .set "OPENAI_AUTH_TOKEN" "oauth-test")
(var openai_codex_payload (build_provider_payload "openai" openai_request))
(assert (openai_codex_payload/tools/0/type == "function"))
(assert (openai_codex_payload/tools/0/name == "fake_echo"))
(assert (openai_codex_payload/tools/0/parameters/type == "object"))
($env .set "OPENAI_AUTH_TOKEN" "")

(append_event run/id "model.response" {
  ^step 1
  ^kind "tool_calls"
  ^content ""
  ^tool_calls [{^id "call-1" ^name "fake.echo" ^args {^text "hello"}}]
})
(append_event run/id "tool.result" {
  ^tool "fake.echo"
  ^call_id "call-1"
  ^status "ok"
  ^result {^status "ok" ^value "hello"}
})
(var tool_history_request (build_model_request "openai" run (events_for run/id) (tool_defs) {^model "gpt-test"}))
(var tool_history_openai_payload (build_provider_payload "openai" tool_history_request))
(assert (tool_history_openai_payload/messages/.size == 2))
(assert (tool_history_openai_payload/messages/1/role == "user"))
(assert (tool_history_openai_payload/messages/1/content .contains "Previous tool results"))
(assert (tool_history_openai_payload/messages/1/content .contains "fake.echo ok"))
(assert (tool_history_openai_payload/messages/1/content .contains "hello"))
(assert (tool_history_openai_payload/messages/1/content .contains "do not repeat"))
(assert (tool_history_openai_payload/messages/1/content .contains "empty output"))
(assert (tool_history_openai_payload/input/.size == 1))
(assert (tool_history_openai_payload/input/0/content .contains "Previous tool results"))

(var long_output "")
(var long_index 0)
(while (long_index < 6000)
  (long_output = #"#{long_output}x")
  (long_index += 1)
)
(append_event run/id "tool.result" {
  ^tool "shell.run"
  ^call_id "call-long"
  ^status "ok"
  ^result {^status "ok" ^output long_output}
})
(var compact_history_payload (build_provider_payload "openai" (build_model_request "openai" run (events_for run/id) (tool_defs) {^model "gpt-test"})))
(assert (compact_history_payload/messages/1/content/.size < 7000))

(var restored_calls (restore_tool_call_names [{^id "call-1" ^name "fake_echo" ^args {^text "hello"}}] openai_request/tool_name_map))
(assert (restored_calls/0/name == "fake.echo"))
(assert (restored_calls/0/args/text == "hello"))

(var openai_status (provider_status "openai" openai_request))
(assert ((model_live_enabled) == false))
(assert (openai_status/live_enabled == false))
(assert (openai_status/configured == false))
(assert (openai_status/model == "gpt-test"))
(assert ((provider_has_credentials "openai" openai_request) == false))

(var openai_result (call_model "openai" openai_request))
(assert (openai_result/ok == false))
(var openai_error_user_content ((openai_result/payload/messages/1/content || "") .to_s))
(assert (openai_error_user_content .contains "gateway should call tools"))
(assert (openai_result/status/live_enabled == false))
(assert (openai_result/error .contains "GENECLAW_MODEL_LIVE"))
(assert (openai_result/error_info/category == "config_error"))
(assert (openai_result/error_info/retryable == false))
(assert (openai_result/started_at_ms > 0))
(assert (openai_result/completed_at_ms >= openai_result/started_at_ms))
(assert (openai_result/duration_ms == (openai_result/completed_at_ms - openai_result/started_at_ms)))

(var anthropic_payload (build_provider_payload "anthropic" (build_model_request "anthropic" run (events_for run/id) (tool_defs) {^model "claude-test"})))
(assert (anthropic_payload/model == "claude-test"))
(assert (anthropic_payload/messages/0/role == "user"))
(assert (anthropic_payload/messages/0/content/0/type == "text"))
(assert (anthropic_payload/tools/0/name == "fake_echo"))
(assert (anthropic_payload/tools/0/input_schema/type == "object"))

(var anthropic_result (call_model "anthropic" (build_model_request "anthropic" run (events_for run/id) (tool_defs) {^model "claude-test"})))
(assert (anthropic_result/ok == false))
(assert (anthropic_result/status/configured == false))
(assert (anthropic_result/payload/messages/0/content/0/text .contains "gateway should call tools"))
(assert (anthropic_result/error .contains "GENECLAW_MODEL_LIVE"))
(assert (anthropic_result/error_info/category == "config_error"))
(assert (anthropic_result/started_at_ms > 0))
(assert (anthropic_result/completed_at_ms >= anthropic_result/started_at_ms))
(assert (anthropic_result/duration_ms == (anthropic_result/completed_at_ms - anthropic_result/started_at_ms)))

(var normalized_openai_chat (normalize_openai_response {
  ^choices [
    {^message {
      ^content "Need a tool."
      ^tool_calls [
        {^id "call-1" ^function {^name "fake.echo" ^arguments "{\"text\":\"hello\"}"}}
      ]
    }}
  ]
}))
(assert (normalized_openai_chat/kind == "tool_calls"))
(assert (normalized_openai_chat/content == "Need a tool."))
(assert (normalized_openai_chat/tool_calls/0/id == "call-1"))
(assert (normalized_openai_chat/tool_calls/0/name == "fake.echo"))
(assert (normalized_openai_chat/tool_calls/0/args/text == "hello"))

(var normalized_openai_responses (normalize_openai_response {
  ^output [
    {^type "message" ^content [{^type "output_text" ^text "Created file."}]}
    {^type "function_call" ^call_id "call-2" ^name "file.read" ^arguments "{\"path\":\"README.md\"}"}
  ]
}))
(assert (normalized_openai_responses/kind == "tool_calls"))
(assert (normalized_openai_responses/content == "Created file."))
(assert (normalized_openai_responses/tool_calls/0/name == "file.read"))
(assert (normalized_openai_responses/tool_calls/0/args/path == "README.md"))

(var normalized_anthropic (normalize_anthropic_response {
  ^content [
    {^type "text" ^text "Reading file."}
    {^type "tool_use" ^id "toolu-1" ^name "file.read" ^input {^path "README.md"}}
  ]
}))
(assert (normalized_anthropic/kind == "tool_calls"))
(assert (normalized_anthropic/content == "Reading file."))
(assert (normalized_anthropic/tool_calls/0/id == "toolu-1"))
(assert (normalized_anthropic/tool_calls/0/name == "file.read"))
(assert (normalized_anthropic/tool_calls/0/args/path == "README.md"))

(var error_message (error_message_from_response {
  ^type "error"
  ^message "Bad credentials"
  ^status 401
  ^raw_body "{\"error\":\"invalid\"}"
}))
(assert (error_message .contains "Bad credentials"))
(assert (error_message .contains "status=401"))
(assert (error_message .contains "body={\"error\""))

(var auth_error (classify_model_error "openai" {^status 401} error_message))
(assert (auth_error/category == "auth_error"))
(assert (auth_error/retryable == false))

(var instance_error (new OpenAIError))
(instance_error/type = "error")
(instance_error/message = "Provided authentication token is expired. Please try signing in again.")
(instance_error/status = 401)
(instance_error/raw_body = "{\"error\":{\"code\":\"token_expired\"},\"status\":401}")
(var instance_error_message (error_message_from_response instance_error))
(assert (instance_error_message .contains "authentication token is expired"))
(assert (instance_error_message .contains "status=401"))
(var instance_auth_error (classify_model_error "openai" instance_error instance_error_message))
(assert (instance_auth_error/category == "auth_error"))
(assert (instance_auth_error/status_code == 401))

(var rate_error (classify_model_error "openai" {^status 429} "rate limited"))
(assert (rate_error/category == "rate_limited"))
(assert (rate_error/retryable == true))
(var server_error (classify_model_error "anthropic" {^status 503} "service unavailable"))
(assert (server_error/category == "provider_unavailable"))
(assert (server_error/retryable == true))

(var stream_delta (stream_event_from_delta "openai" {^content "hello"}))
(assert (stream_delta/type == "model.stream.delta"))
(assert (stream_delta/content == "hello"))
(var stream_done (stream_event_from_delta "anthropic" {^stop_reason "end_turn"}))
(assert (stream_done/type == "model.stream.done"))
(assert (stream_done/stop_reason == "end_turn"))

(var events (events_for run/id))
(assert (has_event_type events "run.started"))

(println "ok")
