#!/usr/bin/env gene run

(import reset_runs create_run from "kernel/runs")
(import events_for has_event_type last_event_of_type from "kernel/events")
(import set_store_root from "kernel/storage")
(import normalize_budgets bound_inline_text output_limit_from_args deadline_exceeded from "kernel/limits")
(import reset_tools invoke_tool from "tools/registry")
(import register_fake_tools from "tools/fake")
(import register_builtin_tools set_workspace_root from "tools/builtin")
(import run_agent from "agent_loop")

($env .set "GENECLAW_MODEL_LIVE" "false")
($env .set "GENECLAW_PROVIDER" "")
($env .set "GENECLAW_PROFILE" "")
($env .set "GENECLAW_MODEL" "")
($env .set "GENECLAW_DEFAULT_PROVIDER" "")
($env .set "GENECLAW_DEFAULT_PROFILE" "")
($env .set "GENECLAW_DEFAULT_MODEL" "")

(set_store_root "/tmp/geneclaw-new-test-limits-store")
(reset_runs)
(reset_tools)
(register_fake_tools)

(var budgets (normalize_budgets {^steps 0 ^tool_calls 0 ^tokens 0 ^deadline_ms 0 ^max_output_bytes 12}))
(assert (budgets/steps == 0))
(assert (budgets/tool_calls == 0))
(assert (budgets/tokens == 0))
(assert (budgets/deadline_ms == 0))
(assert (budgets/max_output_bytes == 12))

(var bounded (bound_inline_text "abcdef" 3))
(assert (bounded/truncated == true))
(assert (bounded/text == "abc...[truncated]"))
(assert (bounded/bytes == 6))
(assert ((output_limit_from_args {^max_output_bytes 7}) == 7))

(var run (create_run "budget shape" "limits" budgets))
(assert (run/budgets/steps == 0))
(assert (run/deadline_ms == 0))
(assert (deadline_exceeded run/deadline_at_ms))

(var timed_out (run_agent "cannot take a step" "limits" {^steps 0}))
(assert (timed_out/state == "timed_out"))
(var timed_out_events (events_for timed_out/id))
(assert (has_event_type timed_out_events "run.timed_out"))
(assert (has_event_type timed_out_events "workflow.failed"))

(var workspace "/tmp/geneclaw-new-test-limits-workspace")
(system/shell #"rm -rf '#{workspace}' && mkdir -p '#{workspace}/sub'")
(gene/io/write #"#{workspace}/sub/file.txt" "abc")
(set_workspace_root workspace)
(reset_tools)
(register_builtin_tools)

(var tool_run (create_run "tool limits" "limits"))
(var shell_result (invoke_tool tool_run/id "shell.run" {^cmd "pwd" ^cwd "sub" ^timeout_ms 5}))
(assert (shell_result/status == "ok"))
(assert (shell_result/cwd == "sub"))
(assert (shell_result/timeout_ms == 5))
(assert (shell_result/timeout_enforced == true))
(assert (shell_result/timed_out == false))
(assert (shell_result/output .contains "/sub"))

(var timeout_result (invoke_tool tool_run/id "shell.run" {^cmd "sleep 1" ^cwd "." ^timeout_ms 10}))
(assert (timeout_result/status == "failed"))
(assert (timeout_result/timeout_enforced == true))
(assert (timeout_result/timed_out == true))

(var big "")
(var index 0)
(while (index < 30)
  (big = #"#{big}x")
  (index += 1)
)
(gene/io/write #"#{workspace}/big.txt" big)
(var big_read (invoke_tool tool_run/id "file.read" {^path "big.txt" ^max_output_bytes 10}))
(assert ((big_read .get "content_truncated") == true))
(assert ((big_read .get "content_limit") == 10))
(assert ((big_read .get "content_bytes") == 30))

(var result_event (last_event_of_type (events_for tool_run/id) "tool.result"))
(assert (result_event/data/status == "ok"))

(println "ok")
