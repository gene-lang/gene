#!/usr/bin/env gene run

(var store_root "/tmp/geneclaw-new-test-cli-store")

(system/shell #"rm -rf '#{store_root}'")

(var first (system/run
  "../../bin/gene" "run" "src/main.gene" "run" "hi"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false"}
  ^stderr_to_stdout true))
(assert (first/exit_code == 0))
(assert (first/output .contains "run-1 completed"))
(assert (first/output .contains "Done: echo: hi"))

(var second (system/run
  "../../bin/gene" "run" "src/main.gene" "run"
  "--profile" "fake" "--steps" "4" "--tool-calls" "2" "hello cli"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false"}
  ^stderr_to_stdout true))
(assert (second/exit_code == 0))
(assert (second/output .contains "run-2 completed"))
(assert (second/output .contains "Done: echo: hello cli"))

(var live_without_auth (system/run
  "../../bin/gene" "run" "src/main.gene" "run" "env live"
  ^env {
    ^GENECLAW_NEW_HOME store_root
    ^GENECLAW_MODEL_LIVE "true"
    ^OPENAI_MODEL "gpt-env-default"
    ^OPENAI_API_KEY ""
    ^OPENAI_AUTH_TOKEN ""
    ^OPENAI_OAUTH_TOKEN ""
    ^ANTHROPIC_API_KEY ""
    ^ANTHROPIC_AUTH_TOKEN ""
    ^ANTHROPIC_OAUTH_TOKEN ""
  }
  ^stderr_to_stdout true))
(assert (live_without_auth/exit_code == 0))
(assert (live_without_auth/output .contains "run-3 failed"))
(assert (live_without_auth/output .contains "openai live adapter requires"))

(var live_events (system/run
  "../../bin/gene" "run" "src/main.gene" "events" "run-3"
  ^env {^GENECLAW_NEW_HOME store_root}
  ^stderr_to_stdout true))
(assert (live_events/exit_code == 0))
(assert (live_events/output .contains "^provider \"openai\""))
(assert (live_events/output .contains "^profile \"standard\""))
(assert (live_events/output .contains "^model \"gpt-env-default\""))

(var eval_first (system/run
  "../../bin/gene" "run" "src/main.gene" "run" "(+ 1 2)"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false" ^GENECLAW_GENE_BIN "../../bin/gene"}
  ^stderr_to_stdout true))
(assert (eval_first/exit_code == 0))
(assert (eval_first/output .contains "run-4 completed: 3"))

(var eval_define (system/run
  "../../bin/gene" "run" "src/main.gene" "run" "(var cli_eval_x 8)"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false" ^GENECLAW_GENE_BIN "../../bin/gene"}
  ^stderr_to_stdout true))
(assert (eval_define/exit_code == 0))
(assert (eval_define/output .contains "run-5 completed"))

(var eval_second (system/run
  "../../bin/gene" "run" "src/main.gene" "run" "(+ cli_eval_x 4)"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false" ^GENECLAW_GENE_BIN "../../bin/gene"}
  ^stderr_to_stdout true))
(assert (eval_second/exit_code == 0))
(assert (eval_second/output .contains "run-6 completed: 12"))

(var eval_equals (system/run
  "../../bin/gene" "run" "src/main.gene" "run" "= (+ cli_eval_x 5)"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false" ^GENECLAW_GENE_BIN "../../bin/gene"}
  ^stderr_to_stdout true))
(assert (eval_equals/exit_code == 0))
(assert (eval_equals/output .contains "run-7 completed: 13"))

(var eval_events (system/run
  "../../bin/gene" "run" "src/main.gene" "events" "run-7"
  ^env {^GENECLAW_NEW_HOME store_root}
  ^stderr_to_stdout true))
(assert (eval_events/exit_code == 0))
(assert (eval_events/output .contains "code.eval.started"))
(assert (eval_events/output .contains "code.eval.completed"))
(assert (eval_events/output .contains "^goal \"(+ cli_eval_x 5)\""))
(assert ((eval_events/output .contains "^goal \"= (+ cli_eval_x 5)\"") == false))

(var shell_run (system/run
  "../../bin/gene" "run" "src/main.gene" "run" "! printf shell-ok | tr a-z A-Z"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false"}
  ^stderr_to_stdout true))
(assert (shell_run/exit_code == 0))
(assert (shell_run/output .contains "run-8 completed: SHELL-OK"))

(var shell_events (system/run
  "../../bin/gene" "run" "src/main.gene" "events" "run-8"
  ^env {^GENECLAW_NEW_HOME store_root}
  ^stderr_to_stdout true))
(assert (shell_events/exit_code == 0))
(assert (shell_events/output .contains "shell.command.started"))
(assert (shell_events/output .contains "shell.command.completed"))
(assert (shell_events/output .contains "^goal \"printf shell-ok | tr a-z A-Z\""))
(assert ((shell_events/output .contains "^goal \"! printf shell-ok") == false))

(var tui_shell (system/run
  "../../bin/gene" "run" "src/main.gene" "tui"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false" ^GENECLAW_GENE_BIN "../../bin/gene"}
  ^input "!printf daemon\n/exit\n"
  ^stderr_to_stdout true))
(assert (tui_shell/exit_code == 0))
(assert (tui_shell/output .contains "0009\u203a "))
(assert (tui_shell/output .contains "Ran !printf daemon"))
(assert (tui_shell/output .contains "daemon"))
(assert ((tui_shell/output .contains "completed: daemon") == false))
(assert ((tui_shell/output .contains "\u2514 daemon") == false))

(var tui_code (system/run
  "../../bin/gene" "run" "src/main.gene" "tui"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false" ^GENECLAW_GENE_BIN "../../bin/gene"}
  ^input "(var tui_code_a 1) (tui_code_a + 2)\n/exit\n"
  ^stderr_to_stdout true))
(assert (tui_code/exit_code == 0))
(assert (tui_code/output .contains "0010\u203a "))
(assert (tui_code/output .contains "Evaluating Gene code"))
(assert (tui_code/output .contains "3"))
(assert ((tui_code/output .contains "completed: 3") == false))
(assert ((tui_code/output .contains "\u2514 3") == false))

(var tui_exit (system/run
  "../../bin/gene" "run" "src/main.gene" "tui"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false" ^GENECLAW_GENE_BIN "../../bin/gene"}
  ^input "/exit\n"
  ^stderr_to_stdout true))
(assert (tui_exit/exit_code == 0))
(assert (tui_exit/output .contains "GeneClaw TUI"))
(assert (tui_exit/output .contains "/help shows commands"))
(assert (tui_exit/output .contains "Shift-Enter inserts a newline"))
(assert (tui_exit/output .contains "0011\u203a "))
(assert (tui_exit/output .contains "bye"))

(var tui_agent (system/run
  "../../bin/gene" "run" "src/main.gene" "tui" "--provider" "fake"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false" ^GENECLAW_GENE_BIN "../../bin/gene"}
  ^input "hello tui\n/exit\n"
  ^stderr_to_stdout true))
(assert (tui_agent/exit_code == 0))
(assert (tui_agent/output .contains "Working"))
(assert (tui_agent/output .contains "Done: echo: hello tui"))
(assert ((tui_agent/output .contains "completed: Done: echo: hello tui") == false))

(var tui_slash (system/run
  "../../bin/gene" "run" "src/main.gene" "tui"
  ^env {^GENECLAW_NEW_HOME store_root ^GENECLAW_MODEL_LIVE "false" ^GENECLAW_GENE_BIN "../../bin/gene"}
  ^input "/help\n/reset\n/exit\n"
  ^stderr_to_stdout true))
(assert (tui_slash/exit_code == 0))
(assert (tui_slash/output .contains "Commands:"))
(assert (tui_slash/output .contains "/reset"))
(assert (tui_slash/output .contains "session reset"))
(assert (tui_slash/output .contains "0001\u203a "))
(assert ((tui_slash/output .contains "geneclaw 001>") == false))

(println "ok")
