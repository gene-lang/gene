#!/usr/bin/env gene run

(import reset_runs create_run from "kernel/runs")
(import append_event events_for has_event_type last_event_of_type from "kernel/events")
(import set_store_root from "kernel/storage")
(import reset_tools from "tools/registry")
(import register_fake_tools from "tools/fake")
(import register_code_eval_tools from "code_eval")
(import already_attempted_tool_calls already_completed_tool_calls deduped_final_content repeated_tool_call_fallback_content repeated_tool_call_final_content run_agent from "agent_loop")

($env .set "GENECLAW_MODEL_LIVE" "false")
($env .set "GENECLAW_PROVIDER" "")
($env .set "GENECLAW_PROFILE" "")
($env .set "GENECLAW_MODEL" "")
($env .set "GENECLAW_DEFAULT_PROVIDER" "")
($env .set "GENECLAW_DEFAULT_PROFILE" "")
($env .set "GENECLAW_DEFAULT_MODEL" "")
($env .set "GENECLAW_GENE_BIN" "../../bin/gene")

(set_store_root "/tmp/geneclaw-new-test-agent-slice")
(reset_runs)
(reset_tools)
(register_fake_tools)
(register_code_eval_tools)

(var summary (run_agent "review the current diff" "cli" {^steps 4 ^tool_calls 2}))
(assert (summary/id == "run-1"))
(assert (summary/state == "completed"))
(assert (summary/final .contains "echo: review the current diff"))

(var events (events_for summary/id))
(assert (has_event_type events "run.started"))
(assert (has_event_type events "model.request"))
(assert (has_event_type events "model.response"))
(assert (has_event_type events "tool.call"))
(assert (has_event_type events "tool.result"))
(assert (has_event_type events "workflow.started"))
(assert (has_event_type events "workflow.step.started"))
(assert (has_event_type events "workflow.step.completed"))
(assert (has_event_type events "workflow.completed"))
(assert (has_event_type events "run.completed"))

(var tool_result (last_event_of_type events "tool.result"))
(assert (tool_result/data/tool == "fake.echo"))
(assert (tool_result/data/result/value == "review the current diff"))

(var model_response (last_event_of_type events "model.response"))
(assert (model_response/data/started_at_ms > 0))
(assert (model_response/data/completed_at_ms >= model_response/data/started_at_ms))
(assert (model_response/data/duration_ms == (model_response/data/completed_at_ms - model_response/data/started_at_ms)))

(var mixed_summary (run_agent "mixed eval tools" "cli" {^steps 4 ^tool_calls 4}))
(assert (mixed_summary/state == "completed"))
(assert (mixed_summary/final .contains "Done: echo: mixed ok"))
(assert ((mixed_summary/final .contains "Gene code:") == false))
(var mixed_events (events_for mixed_summary/id))
(assert (has_event_type mixed_events "tool.result"))
(assert (has_event_type mixed_events "model.response"))

(var repeat_final_summary (run_agent "repeat final tool" "cli" {^steps 4 ^tool_calls 3}))
(assert (repeat_final_summary/state == "completed"))
(assert (repeat_final_summary/final .contains "Tool results:"))
(assert (repeat_final_summary/final .contains "fake.echo returned repeat final tool"))
(assert ((repeat_final_summary/final .contains "bad repeated final content") == false))

(reset_tools)
(var failed_tool_summary (run_agent "recover from missing tool" "cli" {^steps 3 ^tool_calls 2}))
(assert (failed_tool_summary/state == "completed"))
(assert (failed_tool_summary/final .contains "Unknown tool: fake.echo"))
(var failed_tool_events (events_for failed_tool_summary/id))
(var failed_tool_result (last_event_of_type failed_tool_events "tool.result"))
(assert (failed_tool_result/data/status == "failed"))
(assert (has_event_type failed_tool_events "workflow.completed"))

(var duplicate_run (create_run "dedupe repeated tool call" "cli"))
(append_event duplicate_run/id "tool.result" {
  ^tool "shell.run"
  ^call_id "call-dup"
  ^status "ok"
  ^result {^status "ok" ^output "listed tmp"}
})
(assert (already_completed_tool_calls duplicate_run/id [{^id "call-dup" ^name "shell.run" ^args {}}]))
(assert ((deduped_final_content duplicate_run/id "") == "listed tmp"))
(assert ((deduped_final_content duplicate_run/id "I will answer") == "listed tmp"))

(var repeat_run (create_run "dedupe repeated mixed tool calls" "cli"))
(append_event repeat_run/id "tool.result" {
  ^tool "search.rg"
  ^call_id "call-failed"
  ^status "failed"
  ^result {^status "failed" ^error "Path must be relative to the workspace"}
})
(append_event repeat_run/id "tool.result" {
  ^tool "web.search"
  ^call_id "call-ok"
  ^status "ok"
  ^result {^status "ok" ^output "listed web"}
})
(var repeated_calls [
  {^id "call-failed" ^name "search.rg" ^args {}}
  {^id "call-ok" ^name "web.search" ^args {}}
])
(assert (already_attempted_tool_calls repeat_run/id repeated_calls))
(assert ((already_completed_tool_calls repeat_run/id repeated_calls) == false))
(assert ((repeated_tool_call_final_content repeat_run/id "model answer") == "model answer"))
(assert ((repeated_tool_call_final_content repeat_run/id "") == "listed web"))

(var content_run (create_run "dedupe repeated content tool call" "cli"))
(append_event content_run/id "tool.result" {
  ^tool "file.read"
  ^call_id "call-content"
  ^status "ok"
  ^result {^status "ok" ^content "readme body"}
})
(assert ((deduped_final_content content_run/id "") == "readme body"))
(assert ((repeated_tool_call_final_content content_run/id "") == "readme body"))

(var empty_run (create_run "dedupe repeated empty tool calls" "cli"))
(append_event empty_run/id "tool.result" {
  ^tool "search.rg"
  ^call_id "call-search-empty"
  ^status "ok"
  ^result {^status "ok" ^output ""}
})
(append_event empty_run/id "tool.result" {
  ^tool "shell.run"
  ^call_id "call-find-empty"
  ^status "ok"
  ^result {^status "ok" ^output ""}
})
(var empty_fallback (repeated_tool_call_fallback_content empty_run/id))
(assert (empty_fallback .contains "Using recorded tool results"))
(assert (empty_fallback .contains "search.rg returned no output"))
(assert (empty_fallback .contains "shell.run returned no output"))
(assert ((repeated_tool_call_final_content empty_run/id "") == empty_fallback))

(println "ok")
