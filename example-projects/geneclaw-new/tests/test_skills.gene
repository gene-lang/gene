#!/usr/bin/env gene run

(import reset_runs create_run from "kernel/runs")
(import events_for has_event_type last_event_of_type from "kernel/events")
(import set_store_root from "kernel/storage")
(import reset_tools tool_defs from "tools/registry")
(import register_fake_tools from "tools/fake")
(import register_builtin_tools from "tools/builtin")
(import register_code_eval_tools from "code_eval")
(import load_skill skill_tool_names filter_tool_defs_for_skill provider_tool_specs_for_skill infer_skill_name from "skills/loader")
(import run_agent_with_options from "agent_loop")
(import build_model_request build_provider_payload from "models/gateway")

($env .set "GENECLAW_MODEL_LIVE" "false")
($env .set "GENECLAW_PROVIDER" "")
($env .set "GENECLAW_PROFILE" "")
($env .set "GENECLAW_MODEL" "")
($env .set "GENECLAW_DEFAULT_PROVIDER" "")
($env .set "GENECLAW_DEFAULT_PROFILE" "")
($env .set "GENECLAW_DEFAULT_MODEL" "")

(set_store_root "/tmp/geneclaw-new-test-skills-store")
(reset_runs)
(reset_tools)
(register_fake_tools)
(register_builtin_tools)
(register_code_eval_tools)

(var skill (load_skill "repo-review"))
(assert (skill/name == "repo-review"))
(assert (skill/version == "0.1.0"))
(assert (skill/tools/.size == 4))
(assert (skill/workflows/0/name == "default"))
(assert (skill/examples/0/input == "review the current diff"))

(var names (skill_tool_names skill))
(assert (names/.size == 4))
(assert (names .contains "fake.echo"))
(assert (names .contains "search.rg"))

(var filtered (filter_tool_defs_for_skill (tool_defs) skill))
(assert (filtered/.size == 4))

(var openai_specs (provider_tool_specs_for_skill "openai" skill (tool_defs)))
(assert (openai_specs/.size == 4))
(assert (openai_specs/0/type == "function"))

(var anthropic_specs (provider_tool_specs_for_skill "anthropic" skill (tool_defs)))
(assert (anthropic_specs/.size == 4))
(assert ((anthropic_specs/0/name || "") .not_empty))
(assert (anthropic_specs/0/input_schema/type == "object"))

(var summary (run_agent_with_options "review the current diff" "cli" {^steps 4 ^tool_calls 2} {^skill "repo-review"}))
(assert (summary/state == "completed"))
(assert (summary/final .contains "echo: review the current diff"))

(var events (events_for summary/id))
(assert (has_event_type events "skill.loaded"))
(assert (has_event_type events "model.request"))
(assert (has_event_type events "workflow.started"))
(assert (has_event_type events "workflow.completed"))
(var skill_loaded (last_event_of_type events "skill.loaded"))
(assert (skill_loaded/data/name == "repo-review"))
(var workflow_started (last_event_of_type events "workflow.started"))
(assert (workflow_started/data/workflow == "default"))
(assert (workflow_started/data/source == "skill"))
(assert ((workflow_started/data .get "skill") == "repo-review"))
(assert (workflow_started/data/declared_step_count == 4))
(var request_event (last_event_of_type events "model.request"))
(assert ((request_event/data .get "skill") == "repo-review"))
(assert (request_event/data/tool_count == 4))

(var gene_skill (load_skill "gene-coding"))
(assert (gene_skill/name == "gene-coding"))
(assert (gene_skill/version == "0.1.0"))
(assert (gene_skill/tools/.size == 5))
(assert (gene_skill/system .contains "gene.eval"))
(assert (gene_skill/system .contains "plain gene eval does not define"))
(assert (gene_skill/system .contains "geneclaw/session"))
(assert (gene_skill/system .contains "GENECLAW_MODEL_LIVE"))
(assert (gene_skill/examples/.size == 2))

(var gene_tool_names (skill_tool_names gene_skill))
(assert (gene_tool_names/.size == 5))
(assert (gene_tool_names .contains "gene.eval"))
(assert (gene_tool_names .contains "shell.run"))
(assert (gene_tool_names .contains "file.read"))
(assert (gene_tool_names .contains "search.rg"))
(assert (gene_tool_names .contains "file.patch"))

(var gene_filtered (filter_tool_defs_for_skill (tool_defs) gene_skill))
(assert (gene_filtered/.size == 5))
(assert (gene_filtered/0/name == "gene.eval"))
(var gene_run (create_run "teach me how to run Gene code" "skill-test"))
(var gene_request (build_model_request "openai" gene_run (events_for gene_run/id) gene_filtered {
  ^model "gpt-test"
  ^skill gene_skill/name
  ^system gene_skill/system
}))
(var gene_payload (build_provider_payload "openai" gene_request))
(assert (gene_payload/instructions .contains "gene-coding skill"))
(assert (gene_payload/instructions .contains "gene.eval"))
(assert (gene_payload/instructions .contains "(tool \"name\""))
(assert (gene_payload/instructions .contains "GENECLAW_WORKSPACE_ROOT"))
(assert (gene_payload/tools/.size == 5))

(assert ((infer_skill_name "I meant run gene to access context") == "gene-coding"))
(assert ((infer_skill_name "teach me how to write Gene code") == "gene-coding"))
(assert ((infer_skill_name "change GeneClaw runtime config") == "gene-coding"))
(assert ((infer_skill_name "review the current diff") == "repo-review"))

(var inferred_summary (run_agent_with_options "I meant run gene to access context" "cli" {^steps 4 ^tool_calls 2} {^provider "fake"}))
(assert (inferred_summary/state == "completed"))
(var inferred_events (events_for inferred_summary/id))
(var inferred_loaded (last_event_of_type inferred_events "skill.loaded"))
(assert (inferred_loaded/data/name == "gene-coding"))
(assert (inferred_loaded/data/inferred == true))
(var inferred_request (last_event_of_type inferred_events "model.request"))
(assert ((inferred_request/data .get "skill") == "gene-coding"))
(assert (inferred_request/data/tool_count == 5))

(var eval_summary (run_agent_with_options "evaluate gene code to inspect context" "cli" {^steps 4 ^tool_calls 2} {^provider "fake"}))
(assert (eval_summary/state == "completed"))
(assert (eval_summary/final .contains "Gene code:"))
(assert (eval_summary/final .contains "```gene"))
(assert (eval_summary/final .contains "geneclaw/session"))
(assert (eval_summary/final .contains "Result:"))
(assert (eval_summary/final .contains "fake-inspect"))
(var eval_events (events_for eval_summary/id))
(var eval_tool_result (last_event_of_type eval_events "tool.result"))
(assert (eval_tool_result/data/tool == "gene.eval"))
(assert (eval_tool_result/data/status == "ok"))
(var eval_completed (last_event_of_type eval_events "workflow.completed"))
(assert (eval_completed/data/detail/source == "gene.eval"))

(println "ok")
