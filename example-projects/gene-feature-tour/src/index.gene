#!/usr/bin/env gene run

# Gene feature tour core entrypoint.
# This file intentionally stays small: each imported module owns one feature area.
# Runnable examples are limited to current Stable and Beta surfaces.

(import run_basics_tour from "./core/basics")
(import run_functions_macros_tour from "./core/functions_macros")
(import run_packages_modules_tour from "./core/packages_modules")
(import run_stdlibs_tour from "./core/stdlibs")
(import run_sum_product_types_tour from "./core/sum_product_types")
(import run_patterns_tour from "./core/patterns")
(import run_selectors_tour from "./core/selectors")
(import run_types_tour from "./core/types")
(import run_oop_tour from "./core/oop")
(import run_interception_tour from "./core/interception")
(import run_concurrency_tour from "./core/concurrency")

(fn section [name]
  (println "")
  (println (++ "=== " name " ==="))
)

(fn run_core_tour []
  (println "Gene Feature Tour — core Stable/Beta surfaces")
  (section "basics")
  (run_basics_tour)
  (section "functions and macros")
  (run_functions_macros_tour)
  (section "packages and modules")
  (run_packages_modules_tour)
  (section "standard libraries")
  (run_stdlibs_tour)
  (section "enum ADTs and tuples")
  (run_sum_product_types_tour)
  (section "pattern matching")
  (run_patterns_tour)
  (section "selectors")
  (run_selectors_tour)
  (section "gradual typing")
  (run_types_tour)
  (section "OOP")
  (run_oop_tour)
  (section "explicit interception")
  (run_interception_tour)
  (section "async and actors")
  (run_concurrency_tour)
  (println "")
  (println "Core feature tour complete")
)

(run_core_tour)
